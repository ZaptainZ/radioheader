# Privacy patterns to scan for
_privacy_patterns() {
  # Returns a grep -E compatible pattern for privacy-sensitive content
  echo '\[来源:|/Users/|/home/|/root/|C:\\Users\\|API[_-]?[Kk]ey|api[_-]?key|SECRET|sk-[a-zA-Z0-9]{20,}|AKIA[0-9A-Z]{16}|ghp_[a-zA-Z0-9]{36}|xox[bpoas]-[a-zA-Z0-9-]+'
}

# Check a single shortwave file for quality (returns score 0-8)
_quality_check() {
  local file="$1"
  local score=0
  local issues=""

  # Read file content
  local content
  content=$(cat "$file")

  # Dimension 1: Searchability (0-2)
  # Check tags field has >=3 terms, includes both zh/en
  local tags_line
  tags_line=$(grep '^tags:' "$file" 2>/dev/null || true)
  if [ -n "$tags_line" ]; then
    local tag_count
    tag_count=$(echo "$tags_line" | tr '|' '\n' | wc -l | tr -d ' ')
    if [ "$tag_count" -ge 5 ]; then
      score=$((score + 2))
    elif [ "$tag_count" -ge 3 ]; then
      score=$((score + 1))
      issues+="  ⚠ tags: only $tag_count terms (recommend ≥5)\n"
    else
      issues+="  ✗ tags: only $tag_count terms (need ≥3)\n"
    fi
  else
    issues+="  ✗ missing tags field\n"
  fi

  # Dimension 2: Actionability (0-2)
  # Check for fix/cause fields with concrete content
  local has_fix has_cause
  has_fix=$(grep '^fix:' "$file" 2>/dev/null | wc -l | tr -d ' ')
  has_cause=$(grep '^cause:' "$file" 2>/dev/null | wc -l | tr -d ' ')
  if [ "$has_fix" -gt 0 ] && [ "$has_cause" -gt 0 ]; then
    score=$((score + 2))
  elif [ "$has_fix" -gt 0 ] || [ "$has_cause" -gt 0 ]; then
    score=$((score + 1))
    issues+="  ⚠ missing cause or fix field\n"
  else
    issues+="  ✗ missing both cause and fix fields\n"
  fi

  # Dimension 3: Independence (0-2)
  # Check for project-specific references that should be removed
  local privacy_pattern
  privacy_pattern=$(_privacy_patterns)
  local leaks
  leaks=$(grep -E "$privacy_pattern" "$file" 2>/dev/null | wc -l | tr -d ' ')
  if [ "$leaks" -eq 0 ]; then
    score=$((score + 2))
  elif [ "$leaks" -le 2 ]; then
    score=$((score + 1))
    issues+="  ⚠ $leaks potential privacy leak(s) found\n"
  else
    issues+="  ✗ $leaks privacy leaks found\n"
  fi

  # Dimension 4: Precision (0-2)
  # Check for symptoms field and title specificity
  local has_symptoms has_title
  has_symptoms=$(grep '^symptoms:' "$file" 2>/dev/null | wc -l | tr -d ' ')
  has_title=$(grep '^###' "$file" 2>/dev/null | wc -l | tr -d ' ')
  if [ "$has_symptoms" -gt 0 ] && [ "$has_title" -gt 0 ]; then
    # Check title length (should be descriptive, not too short)
    local title
    title=$(grep '^###' "$file" | head -1 | sed 's/^###[[:space:]]*//')
    local title_len=${#title}
    if [ "$title_len" -ge 15 ]; then
      score=$((score + 2))
    else
      score=$((score + 1))
      issues+="  ⚠ title too short ($title_len chars)\n"
    fi
  elif [ "$has_title" -gt 0 ]; then
    score=$((score + 1))
    issues+="  ⚠ missing symptoms field\n"
  else
    issues+="  ✗ missing ### title\n"
  fi

  echo "$score"
  if [ -n "$issues" ]; then
    echo -e "$issues" >&2
  fi
}

# Check for duplicates in community pool
_dedup_check() {
  local file="$1"
  if [ ! -d "$COMMUNITY_POOL" ]; then
    echo "0"
    return
  fi

  local pool_count
  pool_count=$(find "$COMMUNITY_POOL" -name "*.md" -type f 2>/dev/null | wc -l | tr -d ' ')
  if [ "$pool_count" -eq 0 ]; then
    echo "0"
    return
  fi

  local bname
  bname=$(basename "$file" .md)

  # Check 1: exact filename match
  if [ -f "$COMMUNITY_POOL/$bname.md" ]; then
    echo "exact"
    return
  fi

  # Check 2: slug similarity (same domain prefix + overlapping keywords)
  local domain_prefix
  domain_prefix=$(echo "$bname" | sed 's/^sw-\([a-z]*\)-.*/\1/')
  local slug_keywords
  slug_keywords=$(echo "$bname" | sed 's/^sw-[a-z]*-//' | tr '-' '\n')

  local best_match=""
  local best_overlap=0
  for pf in "$COMMUNITY_POOL"/sw-"$domain_prefix"-*.md; do
    [ -f "$pf" ] || continue
    local pf_base
    pf_base=$(basename "$pf" .md)
    local pf_keywords
    pf_keywords=$(echo "$pf_base" | sed 's/^sw-[a-z]*-//' | tr '-' '\n')

    # Count overlapping keywords
    local overlap=0
    for kw in $slug_keywords; do
      if echo "$pf_keywords" | grep -qw "$kw"; then
        overlap=$((overlap + 1))
      fi
    done
    if [ "$overlap" -gt "$best_overlap" ]; then
      best_overlap=$overlap
      best_match="$pf_base"
    fi
  done

  # Check 3: tags overlap
  local file_tags
  file_tags=$(grep '^tags:' "$file" 2>/dev/null | sed 's/^tags:[[:space:]]*//' | tr '|' '\n' | sed 's/^[[:space:]]*//;s/[[:space:]]*$//' | sort)
  if [ -n "$file_tags" ]; then
    for pf in "$COMMUNITY_POOL"/sw-"$domain_prefix"-*.md; do
      [ -f "$pf" ] || continue
      local pf_tags
      pf_tags=$(grep '^tags:' "$pf" 2>/dev/null | sed 's/^tags:[[:space:]]*//' | tr '|' '\n' | sed 's/^[[:space:]]*//;s/[[:space:]]*$//' | sort)
      if [ -n "$pf_tags" ]; then
        local common
        common=$(comm -12 <(echo "$file_tags") <(echo "$pf_tags") | wc -l | tr -d ' ')
        local total
        total=$(echo "$file_tags" | wc -l | tr -d ' ')
        if [ "$total" -gt 0 ] && [ "$common" -gt 0 ]; then
          local pct=$((common * 100 / total))
          if [ "$pct" -ge 60 ]; then
            local pf_base
            pf_base=$(basename "$pf" .md)
            if [ "$pct" -gt "$best_overlap" ] || [ -z "$best_match" ]; then
              best_overlap=$pct
              best_match="$pf_base (tags ${pct}% overlap)"
            fi
          fi
        fi
      fi
    done
  fi

  # Determine severity: high overlap = block, moderate = warn
  if [ -n "$best_match" ]; then
    # Check if this is a high-confidence duplicate (tags ≥80% or slug keywords ≥4)
    if echo "$best_match" | grep -q "tags.*overlap"; then
      local overlap_pct
      overlap_pct=$(echo "$best_match" | grep -o '[0-9]*%' | tr -d '%')
      if [ "${overlap_pct:-0}" -ge 80 ]; then
        echo "duplicate:$best_match"
        return
      fi
    elif [ "$best_overlap" -ge 4 ]; then
      echo "duplicate:$best_match (slug $best_overlap keywords overlap)"
      return
    fi
    echo "similar:$best_match"
  elif [ "$best_overlap" -ge 3 ]; then
    echo "similar:$best_match"
  else
    echo "0"
  fi
}

cmd_publish() {
  local mode="interactive"
  local auto_sync=0
  local files_to_publish=()

  # Parse flags
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --auto-detect) mode="auto"; shift ;;
      --sync) auto_sync=1; shift ;;
      --help|-h)
        cat <<EOF
${BOLD}radioheader publish${NC} — Publish local shortwave to community

${BOLD}USAGE${NC}
  radioheader publish <file>           Publish a specific shortwave file
  radioheader publish --auto-detect    Scan local shortwave for publishable entries
  radioheader publish --sync           Auto-sync after publish (combines publish + sync)
  radioheader publish --auto-detect --sync

${BOLD}THREE GATES${NC}
  ① Quality:  Four-dimension score ≥ 6/8 (Searchability, Actionability, Independence, Precision)
  ② Privacy:  Regex scan for [来源:], project paths, /Users/, API keys
  ③ Dedup:    Slug + tags similarity check against community pool

Entries passing all three gates are staged in pending-publish/.
Run 'radioheader sync' to push them to the community repository.

EOF
        return 0
        ;;
      *)
        if [ -f "$1" ]; then
          files_to_publish+=("$1")
        elif [ -f "$SHORTWAVE_DIR/$1" ]; then
          files_to_publish+=("$SHORTWAVE_DIR/$1")
        elif [ -f "$SHORTWAVE_DIR/$1.md" ]; then
          files_to_publish+=("$SHORTWAVE_DIR/$1.md")
        else
          err "File not found: $1"
          return 1
        fi
        shift
        ;;
    esac
  done

  if ! community_enabled; then
    warn "Community sharing is disabled."
    echo "  Enable with: radioheader community on"
    return 1
  fi

  # Auto-detect mode: scan all local shortwave
  if [ "$mode" = "auto" ]; then
    if [ ! -d "$SHORTWAVE_DIR" ]; then
      err "No local shortwave directory found."
      return 1
    fi
    for f in "$SHORTWAVE_DIR"/*.md; do
      [ -f "$f" ] || continue
      # Skip if already in community pool
      local bname
      bname=$(basename "$f")
      if [ -f "$COMMUNITY_POOL/$bname" ]; then
        continue
      fi
      # Skip if already in pending-publish
      if [ -f "$PENDING_PUBLISH/$bname" ]; then
        continue
      fi
      files_to_publish+=("$f")
    done
    if [ ${#files_to_publish[@]} -eq 0 ]; then
      ok "No new entries to publish. All local shortwave already in community or pending."
      return 0
    fi
    info "Found ${#files_to_publish[@]} candidate(s) for publishing."
    echo ""
  fi

  if [ ${#files_to_publish[@]} -eq 0 ]; then
    err "No files specified."
    echo "Usage: radioheader publish <file> or radioheader publish --auto-detect"
    return 1
  fi

  mkdir -p "$PENDING_PUBLISH"

  local passed=0
  local failed=0
  local skipped=0

  for file in "${files_to_publish[@]}"; do
    local bname
    bname=$(basename "$file")
    echo -e "${BOLD}━━━ $bname ━━━${NC}"

    # Gate 1: Quality
    local score
    local quality_issues
    quality_issues=$(mktemp)
    score=$(_quality_check "$file" 2>"$quality_issues")
    local grade="D"
    if [ "$score" -ge 7 ]; then grade="A"
    elif [ "$score" -ge 5 ]; then grade="B"
    elif [ "$score" -ge 3 ]; then grade="C"
    fi

    if [ "$score" -ge 6 ]; then
      echo -e "  ① Quality:  ${GREEN}PASS${NC} (${score}/8, Grade $grade)"
    else
      echo -e "  ① Quality:  ${RED}FAIL${NC} (${score}/8, Grade $grade, need ≥6)"
      if [ -s "$quality_issues" ]; then
        cat "$quality_issues" | sed 's/^/  /'
      fi
      rm -f "$quality_issues"
      failed=$((failed + 1))
      echo ""
      continue
    fi
    if [ -s "$quality_issues" ]; then
      cat "$quality_issues" | sed 's/^/  /'
    fi
    rm -f "$quality_issues"

    # Gate 2: Privacy
    local privacy_pattern
    privacy_pattern=$(_privacy_patterns)
    local privacy_hits
    privacy_hits=$(grep -n -E "$privacy_pattern" "$file" 2>/dev/null || true)
    if [ -z "$privacy_hits" ]; then
      echo -e "  ② Privacy:  ${GREEN}PASS${NC} (no sensitive patterns detected)"
    else
      local hit_count
      hit_count=$(echo "$privacy_hits" | wc -l | tr -d ' ')
      echo -e "  ② Privacy:  ${RED}FAIL${NC} ($hit_count sensitive pattern(s) found)"
      echo "$privacy_hits" | while IFS= read -r line; do
        echo -e "    ${YELLOW}→${NC} $line"
      done
      failed=$((failed + 1))
      echo ""
      continue
    fi

    # Gate 3: Dedup
    local dedup_result
    dedup_result=$(_dedup_check "$file")
    if [ "$dedup_result" = "0" ]; then
      echo -e "  ③ Dedup:    ${GREEN}PASS${NC} (no duplicates in community pool)"
    elif [ "$dedup_result" = "exact" ]; then
      echo -e "  ③ Dedup:    ${YELLOW}SKIP${NC} (exact match already in community pool)"
      skipped=$((skipped + 1))
      echo ""
      continue
    elif echo "$dedup_result" | grep -q "^duplicate:"; then
      local dup_to
      dup_to="${dedup_result#duplicate:}"
      echo -e "  ③ Dedup:    ${RED}SKIP${NC} (high-confidence duplicate: $dup_to)"
      echo -e "    ${DIM}Tags ≥80% overlap or slug ≥4 keywords overlap — skipping.${NC}"
      skipped=$((skipped + 1))
      echo ""
      continue
    else
      local similar_to
      similar_to="${dedup_result#similar:}"
      echo -e "  ③ Dedup:    ${YELLOW}WARN${NC} (similar entry: $similar_to)"
      echo -e "    ${DIM}Proceeding — review recommended before sync${NC}"
    fi

    # All gates passed — stage for publishing
    cp "$file" "$PENDING_PUBLISH/$bname"
    echo -e "  ${GREEN}→ Staged${NC} in pending-publish/"
    passed=$((passed + 1))
    echo ""
  done

  # Summary
  echo -e "${BOLD}Summary${NC}"
  echo -e "  Passed:  ${GREEN}$passed${NC}"
  if [ "$failed" -gt 0 ]; then
    echo -e "  Failed:  ${RED}$failed${NC}"
  fi
  if [ "$skipped" -gt 0 ]; then
    echo -e "  Skipped: ${YELLOW}$skipped${NC}"
  fi

  if [ "$passed" -gt 0 ]; then
    if [ "$auto_sync" -eq 1 ]; then
      echo ""
      info "Auto-syncing to community repository..."
      cmd_sync
    else
      echo ""
      echo -e "  ${DIM}Run 'radioheader sync' to push staged entries to the community repository.${NC}"
      echo -e "  ${DIM}Tip: use 'radioheader publish --sync' to auto-sync after publish.${NC}"
    fi
  fi
  echo ""
}

# ============================================================
# vote
# ============================================================

cmd_vote() {
  # Usage: radioheader vote <entry_id> [+1|-1] [reason]
  if [ $# -lt 1 ] || [ "${1:-}" = "--help" ] || [ "${1:-}" = "-h" ]; then
    cat <<EOF

${BOLD}radioheader vote${NC} — Vote on a shortwave entry

${BOLD}USAGE${NC}
  radioheader vote <entry_id> [+1|-1] [reason]

${BOLD}ARGUMENTS${NC}
  entry_id    Shortwave entry ID (e.g. sw-ios-task-inherits-mainactor)
              Also accepts filename (sw-ios-xxx.md) or partial match
  +1 / -1     Upvote (default) or downvote
  reason      Optional reason for the vote

${BOLD}EXAMPLES${NC}
  radioheader vote sw-backend-nginx-trailing-slash
  radioheader vote sw-backend-nginx-trailing-slash +1 "saved me hours"
  radioheader vote sw-ios-preview-crash -1 "outdated, no longer reproduces"

${BOLD}NOTES${NC}
  Votes are stored in pending-votes.jsonl and uploaded on next 'radioheader sync'.
  Duplicate votes (same machine + same entry) are deduplicated by hash.

EOF
    return 0
  fi

  local entry_id="$1"
  local vote_val="${2:-+1}"
  local reason="${3:-}"

  # Strip .md extension if provided
  entry_id="${entry_id%.md}"

  # Normalize vote value
  case "$vote_val" in
    +1|1|up|yes)   vote_val=1 ;;
    -1|down|no)    vote_val=-1 ;;
    *)
      # Maybe user skipped vote_val and this is the reason
      if [ "$vote_val" != "1" ] && [ "$vote_val" != "-1" ]; then
        reason="$vote_val"
        vote_val=1
      fi
      ;;
  esac

  # Validate entry exists (local shortwave or community pool)
  local found=0
  local found_location=""
  if [ -f "$SHORTWAVE_DIR/${entry_id}.md" ]; then
    found=1
    found_location="local shortwave"
  elif [ -d "$COMMUNITY_POOL" ] && [ -f "$COMMUNITY_POOL/${entry_id}.md" ]; then
    found=1
    found_location="community pool"
  else
    # Try partial match (deduplicate by basename)
    local matches
    matches=$(find "$SHORTWAVE_DIR" "$COMMUNITY_POOL" -name "*${entry_id}*.md" 2>/dev/null | awk -F/ '!seen[$NF]++' | head -5)
    if [ -n "$matches" ]; then
      local count
      count=$(echo "$matches" | wc -l | tr -d ' ')
      if [ "$count" -eq 1 ]; then
        entry_id=$(basename "$matches" .md)
        found=1
        if echo "$matches" | grep -q "$SHORTWAVE_DIR"; then
          found_location="local shortwave"
        else
          found_location="community pool"
        fi
      else
        warn "Multiple matches for '$entry_id':"
        echo "$matches" | while read -r f; do
          echo "  $(basename "$f" .md)"
        done
        echo ""
        echo "Please specify the exact entry ID."
        return 1
      fi
    fi
  fi

  if [ "$found" -eq 0 ]; then
    warn "Entry not found: $entry_id"
    echo "  Searched in: shortwave/ and community/pool/"
    echo "  Tip: use 'radioheader search' to find the correct ID."
    return 1
  fi

  # Generate machine hash for dedup (hostname + username, hashed)
  local machine_hash
  machine_hash=$(echo "$(hostname)-$(whoami)" | shasum -a 256 | cut -c1-16)

  # Check for duplicate vote
  if [ -f "$PENDING_VOTES" ]; then
    if grep -q "\"hash\":\"$machine_hash\"" "$PENDING_VOTES" && \
       grep -q "\"id\":\"$entry_id\"" "$PENDING_VOTES"; then
      # Check if same hash+id combo exists on same line
      if grep "\"id\":\"$entry_id\"" "$PENDING_VOTES" | grep -q "\"hash\":\"$machine_hash\""; then
        warn "You already have a pending vote for '$entry_id'."
        echo "  It will be uploaded on next 'radioheader sync'."
        echo "  To change your vote, edit $PENDING_VOTES manually."
        return 0
      fi
    fi
  fi

  # Build vote JSON
  local ts
  ts=$(date -u '+%Y-%m-%dT%H:%M:%SZ')

  local vote_json="{\"id\":\"$entry_id\",\"vote\":$vote_val,\"reason\":\"$reason\",\"ts\":\"$ts\",\"hash\":\"$machine_hash\"}"

  # Append to pending votes
  echo "$vote_json" >> "$PENDING_VOTES"

  # Display confirmation
  local vote_icon
  if [ "$vote_val" -eq 1 ]; then
    vote_icon="${GREEN}👍 +1${NC}"
  else
    vote_icon="${RED}👎 -1${NC}"
  fi

  ok "Vote recorded!"
  echo -e "  Entry:    ${BOLD}$entry_id${NC} ($found_location)"
  echo -e "  Vote:     $vote_icon"
  if [ -n "$reason" ]; then
    echo -e "  Reason:   $reason"
  fi
  echo ""
  echo -e "  ${DIM}Run 'radioheader sync' to upload your vote.${NC}"

  # Show pending vote count
  local pending_count
  pending_count=$(wc -l < "$PENDING_VOTES" | tr -d ' ')
  if [ "$pending_count" -gt 1 ]; then
    echo -e "  ${DIM}($pending_count pending votes total)${NC}"
  fi
}

# ============================================================
# device-sync
# ============================================================

# v2: multi-machine reconcile engine (git sidecar layer).
# Design notes: docs/multi-machine-sync-spec.md. Phase A syncs the plaintext
# knowledge base only; encrypted project memories are Phase B.

SYNC_SETTINGS_JSON="$CLAUDE_DIR/settings.json"
SYNC_HOOK_PATH="$CLAUDE_DIR/hooks/radioheader-git-sync.sh"
SYNC_DIVERGED_MARKER="$RADIOHEADER_DIR/.sync-diverged"
# Visible folder on purpose: iCloud Drive is unreliable with dotfiles, and a
# visible folder keeps the pairing bundle transparent to the user.
SYNC_ICLOUD_DIR="$HOME/Library/Mobile Documents/com~apple~CloudDocs/RadioHeader"
SYNC_PAIR_HEADER="RADIOHEADER-PAIR-V1"

_sync_host_label() {
  scutil --get LocalHostName 2>/dev/null || hostname -s 2>/dev/null || echo machine
}

# .gitignore / .gitattributes are managed files: init/join/encrypt rewrite
# them. With encrypted project-memory sync ON, project-memories/ is tracked
# (git-crypt filtered) instead of ignored.
#
# "ON" means enabled locally OR already enabled in the vault (committed
# .gitattributes has the filter line). The vault check is critical: a keyless
# machine joining an encrypted vault must NOT rewrite the meta from its own
# (false) flag — that would re-ignore project-memories/, untrack every
# encrypted memory from the shared repo and push that deletion to everyone.
_sync_pm_meta_on() {
  if [ "$(config_get device_sync_project_memories false)" = "true" ]; then
    return 0
  fi
  git -C "$RADIOHEADER_DIR" show HEAD:.gitattributes 2>/dev/null \
    | grep -q 'project-memories/\*\* filter=git-crypt'
}

_sync_write_git_meta() {
  cat > "$RADIOHEADER_DIR/.gitignore" <<'SYNCIGNORE'
# --- Managed by `radioheader device-sync` (rewritten on init/join) ---

# SQLite index — rebuilt locally (radioheader index), never synced
search.db
search.db-*

# consolidate-derived — regenerated locally (radioheader consolidate)
context-digest.md
project-registry.md
project-registry.json

# community — independent git repo, each device clones separately
community/

# machine-local settings / state / logs
config.json
error-log.jsonl
search-log.jsonl
pending-votes.jsonl
pending-publish/
.consolidate-counter
.radiomind-suggested
.sync.lock
.sync-diverged
.sync-pm-seen
templates/
__pycache__/
.DS_Store
SYNCIGNORE

  if ! _sync_pm_meta_on; then
    cat >> "$RADIOHEADER_DIR/.gitignore" <<'SYNCIGNORE'

# encrypted project memories — enable with `radioheader device-sync encrypt`
project-memories/
SYNCIGNORE
  fi

  # Append-mostly files get union merge: concurrent edits from two machines
  # both survive instead of conflicting.
  cat > "$RADIOHEADER_DIR/.gitattributes" <<'SYNCATTRS'
# --- Managed by `radioheader device-sync` (rewritten on init/join) ---
shortwave/*.md merge=union
topics/*.md merge=union
INDEX.md merge=union
user-profile.md merge=union
SYNCATTRS

  if _sync_pm_meta_on; then
    cat >> "$RADIOHEADER_DIR/.gitattributes" <<'SYNCATTRS'
# project memories carry real secrets: encrypted at rest in the vault.
# This line MUST be present before any project-memories/ file is committed.
project-memories/** filter=git-crypt diff=git-crypt
SYNCATTRS
  fi
}

# The hook script is embedded here (single source of truth) so that
# `device-sync init` is self-sufficient on installs that only upgraded the CLI.
_sync_write_hook_script() {
  mkdir -p "$CLAUDE_DIR/hooks"
  cat > "$SYNC_HOOK_PATH" <<'GITSYNC_HOOK'
#!/bin/bash
# RadioHeader device-sync hook — reconcile the knowledge base with the vault,
# plus (opt-in) git-crypt-encrypted project memories with tombstone deletes.
# Managed by `radioheader device-sync init` — do not edit (init rewrites it).
#   pull : background reconcile (SessionStart — returns instantly)
#   push : foreground reconcile (Stop)
# Always safe to run: exits 0 when sync is disabled, repo missing, or offline.
export PATH="$HOME/bin:$HOME/.local/bin:$PATH"
set +e
RH="$HOME/.claude/radioheader"
[ -d "$RH/.git" ] || exit 0
grep -Eq '"device_sync_enabled"[[:space:]]*:[[:space:]]*true' "$RH/config.json" 2>/dev/null || exit 0

MODE="${1:-pull}"
# pull re-executes itself detached so the SessionStart hook returns instantly
# instead of blocking session startup on a network round-trip.
if [ "$MODE" = "pull" ] && [ "${RH_SYNC_BG:-}" != "1" ]; then
  RH_SYNC_BG=1 nohup "$0" pull >/dev/null 2>&1 &
  exit 0
fi

cd "$RH" || exit 0

# Concurrency guard: atomic mkdir lock; a lock older than 3 minutes is stale
# (killed run) and gets cleared so sync can never be wedged permanently.
LOCK="$RH/.sync.lock"
[ -d "$LOCK" ] && [ -n "$(find "$LOCK" -maxdepth 0 -mmin +3 2>/dev/null)" ] && rmdir "$LOCK" 2>/dev/null
mkdir "$LOCK" 2>/dev/null || exit 0
trap 'rmdir "$LOCK" 2>/dev/null' EXIT

HOST="$(scutil --get LocalHostName 2>/dev/null || hostname -s 2>/dev/null || echo machine)"

# ---- encrypted project-memory channel (Phase B, quadruple-gated) ----
# ALL of: opt-in flag, git-crypt present, repo unlocked, filter configured.
# Any gate failing silently disables the channel — secrets can never leak as
# plaintext into the vault, and the knowledge base still syncs normally.
PROJECTS="$HOME/.claude/projects"
PM="$RH/project-memories"
SEEN="$RH/.sync-pm-seen"
ME="${RH_SYNC_USER:-$(whoami)}"    # override is for tests only
PM_ON=0
if grep -Eq '"device_sync_project_memories"[[:space:]]*:[[:space:]]*true' "$RH/config.json" 2>/dev/null \
  && command -v git-crypt >/dev/null 2>&1 \
  && [ -f "$RH/.git/git-crypt/keys/default" ] \
  && grep -q 'project-memories/\*\* filter=git-crypt' "$RH/.gitattributes" 2>/dev/null; then
  PM_ON=1
fi

f_mtime() { stat -f %m "$1" 2>/dev/null || stat -c %Y "$1" 2>/dev/null || echo 0; }
# staging dir key <-> local project dir: only the username segment differs
to_local_dir() { printf '%s' "$1" | sed "s/^-HOME-/-Users-$ME-/"; }

collect_pm() {
  [ "$PM_ON" = 1 ] || return 0
  mkdir -p "$PM"
  local md enc key f base tomb ts
  # 1) stage local memory files (a newer tombstone means "deleted elsewhere":
  #    skip unless the local file was recreated/edited after the deletion)
  for md in "$PROJECTS"/-Users-*/memory; do
    [ -d "$md" ] || continue
    ls "$md"/*.md >/dev/null 2>&1 || continue
    enc="$(basename "$(dirname "$md")")"
    key="$(printf '%s' "$enc" | sed 's/^-Users-[^-]*-/-HOME-/')"
    mkdir -p "$PM/$key"
    for f in "$md"/*.md; do
      base="$(basename "$f")"
      tomb="$PM/$key/$base.tombstone"
      if [ -f "$tomb" ]; then
        ts="$(cat "$tomb" 2>/dev/null | tr -cd 0-9)"
        if [ "$(f_mtime "$f")" -gt "${ts:-0}" ] 2>/dev/null; then
          rm -f "$tomb"
        else
          continue
        fi
      fi
      cp -p "$f" "$PM/$key/$base" 2>/dev/null
    done
  done
  # 2) local deletions -> tombstones. Only files this machine saw distributed
  #    (.sync-pm-seen) count: absence of a never-seen file is not a deletion.
  if [ -f "$SEEN" ]; then
    local rel d b
    while IFS= read -r rel; do
      [ -n "$rel" ] || continue
      case "$rel" in *.tombstone) continue ;; esac
      [ -f "$PM/$rel" ] || continue
      # parameter expansion, NOT dirname/basename: staging paths start with
      # "-HOME-" which those tools misparse as an option
      d="${rel%/*}"; b="${rel##*/}"
      if [ ! -f "$PROJECTS/$(to_local_dir "$d")/memory/$b" ]; then
        date +%s > "$PM/$rel.tombstone"
        rm -f "$PM/$rel"
      fi
    done < "$SEEN"
  fi
  # 3) GC tombstones older than 90 days (every machine has long applied them)
  local now t
  now=$(date +%s)
  find "$PM" -name '*.tombstone' -type f 2>/dev/null | while IFS= read -r t; do
    ts="$(cat "$t" 2>/dev/null | tr -cd 0-9)"
    [ $((now - ${ts:-0})) -gt 7776000 ] 2>/dev/null && rm -f "$t"
  done
}

distribute_pm() {
  [ "$PM_ON" = 1 ] || return 0
  [ -d "$PM" ] || return 0
  local t rel base_rel d b ld ts kd key dest f
  # tombstones first: newer local mtime wins (recreation), else delete local
  find "$PM" -name '*.tombstone' -type f 2>/dev/null | while IFS= read -r t; do
    rel="${t#"$PM"/}"; base_rel="${rel%.tombstone}"
    d="${base_rel%/*}"; b="${base_rel##*/}"
    ld="$PROJECTS/$(to_local_dir "$d")/memory"
    ts="$(cat "$t" 2>/dev/null | tr -cd 0-9)"
    if [ -f "$ld/$b" ] && [ "$(f_mtime "$ld/$b")" -gt "${ts:-0}" ] 2>/dev/null; then
      rm -f "$t"
    else
      rm -f "$ld/$b" "$PM/$base_rel" 2>/dev/null
    fi
  done
  # staging -> local (never deletes; deletion is tombstones' job above)
  for kd in "$PM"/-HOME-*; do
    [ -d "$kd" ] || continue
    key="$(basename "$kd")"
    dest="$PROJECTS/$(to_local_dir "$key")/memory"
    mkdir -p "$dest" 2>/dev/null
    for f in "$kd"/*.md; do
      [ -f "$f" ] || continue
      cp -p "$f" "$dest/$(basename "$f")" 2>/dev/null
    done
  done
  # snapshot staging so the next collect can tell deletions from never-seen
  ( cd "$PM" 2>/dev/null && find . -name '*.md' -type f | sed 's|^\./||' ) > "$SEEN" 2>/dev/null
}

collect_pm
git add -A 2>/dev/null
git diff --cached --quiet 2>/dev/null || git commit -q -m "auto-sync: $HOST $(date +%Y-%m-%dT%H:%M)" 2>/dev/null
BEFORE="$(git rev-parse HEAD 2>/dev/null)"
if git pull --no-rebase --no-edit --autostash --quiet >/dev/null 2>&1; then
  rm -f "$RH/.sync-diverged" 2>/dev/null
elif [ -f "$RH/.git/MERGE_HEAD" ]; then
  # A merge actually started and hit a real conflict (offline pulls fail
  # without MERGE_HEAD). Keep the local commit, defer, and leave a marker so
  # `device-sync status` / `doctor` can surface it — never lose work silently.
  git merge --abort 2>/dev/null
  date +%Y-%m-%dT%H:%M > "$RH/.sync-diverged" 2>/dev/null
fi
AFTER="$(git rev-parse HEAD 2>/dev/null)"
git push --quiet 2>/dev/null
distribute_pm
if [ "$BEFORE" != "$AFTER" ] && command -v radioheader >/dev/null 2>&1; then
  radioheader index >/dev/null 2>&1
fi
exit 0
GITSYNC_HOOK
  chmod +x "$SYNC_HOOK_PATH"
}

# Register/unregister the SessionStart+Stop entries in ~/.claude/settings.json
# and, when the Codex compatibility layer is installed, ~/.codex/hooks.json.
# Values cross into python via env vars to avoid shell-escaping issues.
_sync_hooks_json() {
  local mode="$1"
  _sync_hooks_json_one "$mode" "$SYNC_SETTINGS_JSON" ""
  if [ -f "$CODEX_HOOKS_JSON" ]; then
    _sync_hooks_json_one "$mode" "$CODEX_HOOKS_JSON" "startup|resume"
  fi
}

_sync_hooks_json_one() {
  local mode="$1"
  RH_SYNC_MODE="$mode" RH_SYNC_SETTINGS="$2" RH_SYNC_MATCHER="$3" \
  RH_SYNC_TS="$(date +%Y%m%d%H%M%S)" "$RH_PY" - <<'PY'
import json, os

mode = os.environ["RH_SYNC_MODE"]
path = os.environ["RH_SYNC_SETTINGS"]
matcher = os.environ.get("RH_SYNC_MATCHER", "")
ts = os.environ["RH_SYNC_TS"]

data = {}
if os.path.exists(path):
    with open(path) as f:
        raw = f.read()
    with open(f"{path}.bak.{ts}", "w") as bf:
        bf.write(raw)
    try:
        data = json.loads(raw)
    except Exception:
        data = {}

hooks = data.setdefault("hooks", {})
TOKEN = "radioheader-git-sync.sh"

for event in ("SessionStart", "Stop"):
    kept = []
    for group in hooks.get(event, []):
        remaining = [h for h in group.get("hooks", [])
                     if TOKEN not in h.get("command", "")]
        if remaining:
            group = dict(group)
            group["hooks"] = remaining
            kept.append(group)
    hooks[event] = kept

if mode == "register":
    start_entry = {"hooks": [
        {"type": "command", "command": "~/.claude/hooks/radioheader-git-sync.sh pull"}]}
    if matcher:
        start_entry = {"matcher": matcher, "hooks": start_entry["hooks"]}
    hooks["SessionStart"].append(start_entry)
    hooks["Stop"].append({"hooks": [
        {"type": "command", "command": "~/.claude/hooks/radioheader-git-sync.sh push"}]})

for event in list(hooks):
    if not hooks[event]:
        del hooks[event]
if not data.get("hooks"):
    data.pop("hooks", None)

os.makedirs(os.path.dirname(path), exist_ok=True)
with open(path, "w") as f:
    json.dump(data, f, indent=2, ensure_ascii=False)
    f.write("\n")
PY
}

# Commits need an identity; machines without a global gitconfig (fresh macOS,
# CI) get a repo-local fallback so auto-sync never dies on "empty ident".
_sync_git_identity() {
  if ! git -C "$RADIOHEADER_DIR" config user.email >/dev/null 2>&1; then
    git -C "$RADIOHEADER_DIR" config user.email "radioheader-sync@local"
  fi
  if ! git -C "$RADIOHEADER_DIR" config user.name >/dev/null 2>&1; then
    git -C "$RADIOHEADER_DIR" config user.name "RadioHeader Sync ($(_sync_host_label))"
  fi
}

# Drop files that are tracked but now ignored (v1 repos tracked search.db,
# project-registry.md, templates/ — all machine-local in v2).
_sync_untrack_ignored() {
  local ignored
  ignored=$(git -C "$RADIOHEADER_DIR" ls-files -ci --exclude-standard 2>/dev/null || true)
  if [ -n "$ignored" ]; then
    git -C "$RADIOHEADER_DIR" ls-files -ci --exclude-standard -z 2>/dev/null \
      | xargs -0 git -C "$RADIOHEADER_DIR" rm -q --cached -- 2>/dev/null || true
  fi
}

_sync_enabled() {
  [ "$(config_get device_sync_enabled false)" = "true" ]
}

# openssl with PBKDF2 is needed for the passphrase-encrypted (iCloud) bundle.
# Homebrew OpenSSL 3.x always has it; the system LibreSSL depends on version.
_sync_openssl_ok() {
  printf x | openssl enc -aes-256-cbc -pbkdf2 -salt -pass pass:probe >/dev/null 2>&1
}

# Pairing bundle payload (plain form). Contains everything the second machine
# needs except vault credentials: remote URL + (when unlocked) the git-crypt
# key, base64-encoded. NEVER committed — travels via AirDrop or encrypted.
_sync_pair_payload() {
  local remote tmpk
  remote=$(git -C "$RADIOHEADER_DIR" remote get-url origin 2>/dev/null || true)
  printf '%s\nremote=%s\nhost=%s\ncreated=%s\n' \
    "$SYNC_PAIR_HEADER" "$remote" "$(_sync_host_label)" "$(date +%Y-%m-%d)"
  if [ "$(config_get device_sync_project_memories false)" = "true" ] \
    && command -v git-crypt >/dev/null 2>&1 \
    && [ -f "$RADIOHEADER_DIR/.git/git-crypt/keys/default" ]; then
    tmpk=$(mktemp)
    if (cd "$RADIOHEADER_DIR" && git-crypt export-key "$tmpk" 2>/dev/null); then
      printf 'key_b64=%s\n' "$(openssl base64 -A < "$tmpk" 2>/dev/null || true)"
    fi
    rm -f "$tmpk"
  fi
}

# Read the pairing passphrase: env override (tests / scripting) or prompt.
# $1 = "confirm" to ask twice (export side).
_sync_pair_passphrase() {
  local mode="${1:-}" p1 p2
  if [ -n "${RH_PAIR_PASSPHRASE:-}" ]; then
    printf '%s' "$RH_PAIR_PASSPHRASE"
    return 0
  fi
  if [ ! -t 0 ]; then
    return 1
  fi
  read -r -s -p "  Pairing passphrase: " p1 </dev/tty; echo "" >&2
  if [ "$mode" = "confirm" ]; then
    read -r -s -p "  Repeat passphrase:  " p2 </dev/tty; echo "" >&2
    if [ -z "$p1" ] || [ "$p1" != "$p2" ]; then
      return 1
    fi
  fi
  printf '%s' "$p1"
}

# Parse a .rhpair bundle (plain or passphrase-encrypted).
# Sets PAIR_REMOTE / PAIR_HOST / PAIR_KEY_B64. Returns 1 on any failure.
_sync_pair_read() {
  local file="$1" head_line payload data pass
  PAIR_REMOTE=""; PAIR_HOST=""; PAIR_KEY_B64=""
  if [ ! -s "$file" ]; then
    err "Pair file not found or empty: $file"
    return 1
  fi
  head_line=$(head -1 "$file" 2>/dev/null | tr -d '\r\n' || true)
  case "$head_line" in
    "$SYNC_PAIR_HEADER")
      payload=$(cat "$file")
      ;;
    "$SYNC_PAIR_HEADER-ENC")
      if ! pass=$(_sync_pair_passphrase); then
        err "This pair file is passphrase-protected (set RH_PAIR_PASSPHRASE or run interactively)."
        return 1
      fi
      data=$(grep '^data=' "$file" 2>/dev/null | head -1 | cut -d= -f2- || true)
      payload=$(printf '%s' "$data" | openssl base64 -d -A 2>/dev/null \
        | RH_PAIR_PASS="$pass" openssl enc -d -aes-256-cbc -pbkdf2 -pass env:RH_PAIR_PASS 2>/dev/null || true)
      if ! printf '%s\n' "$payload" | head -1 | grep -q "^$SYNC_PAIR_HEADER$"; then
        err "Could not decrypt the pair file — wrong passphrase?"
        return 1
      fi
      ;;
    *)
      err "Not a RadioHeader pair file: $file"
      return 1
      ;;
  esac
  PAIR_REMOTE=$(printf '%s\n' "$payload" | grep '^remote=' | head -1 | cut -d= -f2- || true)
  PAIR_HOST=$(printf '%s\n' "$payload" | grep '^host=' | head -1 | cut -d= -f2- || true)
  PAIR_KEY_B64=$(printf '%s\n' "$payload" | grep '^key_b64=' | head -1 | cut -d= -f2- || true)
  if [ -z "$PAIR_REMOTE" ]; then
    err "Pair file has no remote URL."
    return 1
  fi
  return 0
}

# ---- interactive setup wizard (porcelain over init/join/encrypt/pair) ----
# set -e discipline: flow control via if/case only, never `[ ] && { }`.

_sync_setup_wizard() {
  if [ ! -t 0 ]; then
    err "setup is interactive — run it in a terminal. Non-interactive equivalents:"
    echo "  radioheader device-sync init --remote <url>                    # first machine"
    echo "  radioheader device-sync join <url> [--key <f>] [--pair <f>]    # other machines"
    return 1
  fi

  echo ""
  echo -e "${BOLD}RadioHeader Device Sync Setup${NC}"
  echo ""

  if _sync_enabled && [ -d "$RADIOHEADER_DIR/.git" ]; then
    ok "This Mac is already syncing."
    _sync_setup_offer_pairing
    return 0
  fi

  echo "  1) This is my FIRST Mac — create a new sync vault"
  echo "  2) JOIN an existing sync — another Mac already set one up"
  local choice
  read -r -p "  Choose [1/2]: " choice
  case "$choice" in
    1) _sync_setup_first ;;
    2) _sync_setup_join ;;
    *) err "Invalid choice."; return 1 ;;
  esac
}

_sync_setup_first() {
  local remote="" ans login
  echo ""
  echo "Sync data lives in a PRIVATE git repository that you own."
  if command -v gh >/dev/null 2>&1 && gh auth status >/dev/null 2>&1; then
    read -r -p "GitHub CLI is signed in — create private repo 'radioheader-vault' now? [Y/n]: " ans
    case "$ans" in
      n|N) ;;
      *)
        login=$(gh api user -q .login 2>/dev/null || true)
        if [ -n "$login" ]; then
          if gh repo create radioheader-vault --private >/dev/null 2>&1; then
            ok "Created github.com/$login/radioheader-vault (private)"
          elif gh repo view "$login/radioheader-vault" >/dev/null 2>&1; then
            warn "Repo already exists — using it."
          fi
          remote="https://github.com/$login/radioheader-vault.git"
        fi
        ;;
    esac
  fi
  if [ -z "$remote" ]; then
    echo "  Create one in the browser (choose Private!), then paste its URL here."
    if command -v open >/dev/null 2>&1; then
      open "https://github.com/new?name=radioheader-vault" 2>/dev/null || true
    fi
    read -r -p "  Repository URL: " remote
    if [ -z "$remote" ]; then
      err "A repository URL is required."
      return 1
    fi
  fi

  if ! cmd_device_sync init --remote "$remote"; then
    return 1
  fi

  read -r -p "Also sync project memories? (encrypted: plaintext here, ciphertext in the vault) [Y/n]: " ans
  case "$ans" in
    n|N) ;;
    *)
      if ! cmd_device_sync encrypt; then
        return 1
      fi
      ;;
  esac

  _sync_setup_offer_pairing
}

_sync_setup_offer_pairing() {
  local ans
  echo ""
  read -r -p "Guide your other Mac in now? [Y/n]: " ans
  case "$ans" in
    n|N)
      echo "  Anytime later: radioheader device-sync pair export [--icloud]"
      return 0
      ;;
  esac
  read -r -p "Is the other Mac nearby? [1=yes → AirDrop / 2=no → iCloud + passphrase]: " ans
  if [ "$ans" = "2" ]; then
    if ! cmd_device_sync pair export --icloud; then
      return 1
    fi
    echo ""
    echo "  On the other Mac: radioheader device-sync setup → choose 2) JOIN → enter the passphrase."
  else
    if ! cmd_device_sync pair export; then
      return 1
    fi
    echo ""
    echo "  1. AirDrop ~/Desktop/radioheader-pair.rhpair to the other Mac"
    echo "  2. There, run: radioheader device-sync setup → choose 2) JOIN"
    echo "  3. Delete the pair file on BOTH machines afterwards (it contains the key)"
  fi
}

_sync_setup_join() {
  local pairfile="" ans url="" keyf=""
  echo ""

  # 1) iCloud bundle (materialize an evicted placeholder first if needed)
  local ic="$SYNC_ICLOUD_DIR/pairing.rhpair"
  if [ ! -s "$ic" ] && [ -e "$SYNC_ICLOUD_DIR/.pairing.rhpair.icloud" ] && command -v brctl >/dev/null 2>&1; then
    info "Found a pairing bundle in iCloud — downloading..."
    brctl download "$ic" >/dev/null 2>&1 || true
    local i=0
    while [ ! -s "$ic" ] && [ "$i" -lt 15 ]; do sleep 2; i=$((i + 1)); done
  fi
  if [ -s "$ic" ]; then
    local from
    from=$(grep '^host=' "$ic" 2>/dev/null | head -1 | cut -d= -f2- || true)
    read -r -p "Found an iCloud pairing bundle (from ${from:-unknown}) — use it? [Y/n]: " ans
    case "$ans" in n|N) ;; *) pairfile="$ic" ;; esac
  fi

  # 2) AirDropped pair file (lands in ~/Downloads)
  if [ -z "$pairfile" ]; then
    local dl
    dl=$(ls -t "$HOME/Downloads"/*.rhpair 2>/dev/null | head -1 || true)
    if [ -n "$dl" ]; then
      read -r -p "Found $(basename "$dl") in Downloads — use it? [Y/n]: " ans
      case "$ans" in n|N) ;; *) pairfile="$dl" ;; esac
    fi
  fi

  # 3) manual fallback
  if [ -z "$pairfile" ]; then
    read -r -p "  Vault repository URL: " url
    if [ -z "$url" ]; then
      err "A repository URL is required."
      return 1
    fi
    read -r -p "  git-crypt key file (leave empty if none): " keyf
  fi

  # join, retrying after the user fixes access (join prints the recipe)
  local attempt=0 rc
  while :; do
    rc=0
    if [ -n "$pairfile" ]; then
      cmd_device_sync join --pair "$pairfile" || rc=$?
    elif [ -n "$keyf" ]; then
      cmd_device_sync join "$url" --key "$keyf" || rc=$?
    else
      cmd_device_sync join "$url" || rc=$?
    fi
    if [ "$rc" -eq 0 ]; then
      return 0
    fi
    attempt=$((attempt + 1))
    if [ "$attempt" -ge 3 ]; then
      return "$rc"
    fi
    read -r -p "Fixed the issue above (e.g. signed in)? Retry [Y/n]: " ans
    case "$ans" in n|N) return "$rc" ;; esac
  done
}

cmd_device_sync() {
  local action="${1:-status}"
  local host_label
  host_label="$(_sync_host_label)"

  case "$action" in
    init)
      # Accept: init --remote <url> | init --remote=<url> | init <url> (v1 form)
      local remote_url=""
      shift || true
      while [ $# -gt 0 ]; do
        case "$1" in
          --remote)   remote_url="${2:-}"; shift 2 || shift ;;
          --remote=*) remote_url="${1#--remote=}"; shift ;;
          *)          remote_url="$1"; shift ;;
        esac
      done

      local upgrading=false
      if [ -d "$RADIOHEADER_DIR/.git" ]; then
        upgrading=true
        info "Existing repository found — upgrading it to device-sync v2."
      else
        git -C "$RADIOHEADER_DIR" init --quiet
      fi

      cd "$RADIOHEADER_DIR"
      _sync_write_git_meta
      _sync_git_identity
      git config pull.rebase false
      _sync_untrack_ignored

      git add -A
      if ! git diff --cached --quiet 2>/dev/null; then
        if [ "$upgrading" = true ]; then
          git commit -q -m "device-sync: upgrade sync metadata ($host_label)"
        else
          git commit -q -m "device-sync: initial sync ($host_label)"
        fi
      fi

      # Remote: explicit arg > existing origin > interactive prompt.
      if [ -z "$remote_url" ]; then
        remote_url=$(git remote get-url origin 2>/dev/null || true)
      fi
      if [ -z "$remote_url" ] && [ -t 0 ]; then
        echo ""
        echo -e "${BOLD}Device Sync Setup${NC}"
        echo "  Create a PRIVATE git repo first (your knowledge base will live there),"
        echo "  then paste its URL. Example: git@github.com:you/radioheader-vault.git"
        echo ""
        read -p "  Remote URL: " remote_url
      fi
      if [ -z "$remote_url" ]; then
        err "A remote URL is required: radioheader device-sync init --remote <url>"
        return 1
      fi
      git remote add origin "$remote_url" 2>/dev/null || git remote set-url origin "$remote_url"

      if git push -u origin HEAD --quiet 2>/dev/null; then
        ok "Pushed to $remote_url"
      else
        warn "Initial push failed — remote may be unreachable or already have content."
        echo "  If the remote already has a vault, this machine should join instead:"
        echo "    radioheader device-sync join $remote_url"
        echo "  Otherwise fix access and run: radioheader device-sync now"
      fi

      _sync_write_hook_script
      _sync_hooks_json register
      config_set device_sync_enabled true

      ok "Device sync enabled (auto: SessionStart pull / Stop push)."
      echo ""
      echo "  On your other machines, run:"
      echo "    radioheader device-sync join $remote_url"
      echo ""
      ;;

    join|clone)
      shift || true
      local remote_url="" keyfile="" pairfile="" pair_tmp_key=""
      while [ $# -gt 0 ]; do
        case "$1" in
          --key)    keyfile="${2:-}"; shift 2 || shift ;;
          --key=*)  keyfile="${1#--key=}"; shift ;;
          --pair)   pairfile="${2:-}"; shift 2 || shift ;;
          --pair=*) pairfile="${1#--pair=}"; shift ;;
          *)        remote_url="$1"; shift ;;
        esac
      done
      if [ -n "$pairfile" ]; then
        case "$pairfile" in /*) ;; *) pairfile="$PWD/$pairfile" ;; esac
        # If the bundle is an evicted iCloud placeholder, ask iCloud for it.
        if [ ! -s "$pairfile" ] && command -v brctl >/dev/null 2>&1; then
          brctl download "$pairfile" >/dev/null 2>&1 || true
          local wait_i=0
          while [ ! -s "$pairfile" ] && [ $wait_i -lt 15 ]; do
            [ $wait_i -eq 0 ] && info "Waiting for iCloud to download the pair file..."
            sleep 2; wait_i=$((wait_i + 1))
          done
        fi
        if ! _sync_pair_read "$pairfile"; then
          return 1
        fi
        remote_url="$PAIR_REMOTE"
        if [ -n "$PAIR_KEY_B64" ] && [ -z "$keyfile" ]; then
          pair_tmp_key=$(mktemp)
          printf '%s' "$PAIR_KEY_B64" | openssl base64 -d -A > "$pair_tmp_key" 2>/dev/null || true
          chmod 600 "$pair_tmp_key"
          keyfile="$pair_tmp_key"
        fi
        if [ -n "$PAIR_HOST" ]; then
          info "Pairing with the vault created on $PAIR_HOST"
        fi
      fi
      if [ -z "$remote_url" ]; then
        err "Usage: radioheader device-sync join <remote-url> [--key <keyfile>] [--pair <file>]"
        return 1
      fi
      if [ -n "$keyfile" ]; then
        case "$keyfile" in /*) ;; *) keyfile="$PWD/$keyfile" ;; esac
        if [ ! -f "$keyfile" ]; then
          err "Key file not found: $keyfile"
          if [ -n "$pair_tmp_key" ]; then rm -f "$pair_tmp_key"; fi
          return 1
        fi
        if ! command -v git-crypt >/dev/null 2>&1; then
          err "git-crypt is required for --key. Install: brew install git-crypt"
          if [ -n "$pair_tmp_key" ]; then rm -f "$pair_tmp_key"; fi
          return 1
        fi
      fi
      if [ -d "$RADIOHEADER_DIR/.git" ]; then
        err "Already a git repository."
        echo "  To upgrade it:      radioheader device-sync init"
        echo "  To sync right now:  radioheader device-sync now"
        if [ -n "$pair_tmp_key" ]; then rm -f "$pair_tmp_key"; fi
        return 1
      fi

      # Full safety net before touching anything.
      if [ -d "$RADIOHEADER_DIR/topics" ] || [ -d "$RADIOHEADER_DIR/shortwave" ]; then
        local backup_dir="$RADIOHEADER_DIR.backup.$(date +%Y%m%d%H%M%S)"
        warn "Backing up existing data to $backup_dir"
        cp -R "$RADIOHEADER_DIR" "$backup_dir"
      fi

      local tmp_dir
      tmp_dir=$(mktemp -d)
      if ! git clone --quiet "$remote_url" "$tmp_dir/vault" 2>"$tmp_dir/clone-err"; then
        # Tell the user WHY — for ordinary users "auth failed" needs a recipe,
        # not a generic clone error.
        if grep -qiE "permission denied|authentication|could not read Username|access rights|403" "$tmp_dir/clone-err" 2>/dev/null; then
          err "Clone failed: this Mac has no access to $remote_url"
          if command -v gh >/dev/null 2>&1; then
            echo "  Easiest fix:  gh auth login    (sign in via browser), then retry."
          fi
          echo "  Or add this Mac's SSH key to your GitHub account:"
          echo "    ssh-keygen -t ed25519             # if you don't have one yet"
          echo "    pbcopy < ~/.ssh/id_ed25519.pub    # copies the public key"
          echo "    open https://github.com/settings/ssh/new   # paste & save"
        elif grep -qiE "not found|does not exist|does not appear to be" "$tmp_dir/clone-err" 2>/dev/null; then
          err "Clone failed: repository not found — double-check the URL: $remote_url"
        else
          err "Failed to clone $remote_url"
          sed 's/^/    /' "$tmp_dir/clone-err" 2>/dev/null | head -3
        fi
        rm -rf "$tmp_dir"
        if [ -n "$pair_tmp_key" ]; then rm -f "$pair_tmp_key"; fi
        return 1
      fi
      # Unlock in the pristine temp clone (clean worktree, so git-crypt never
      # refuses); the key and filter config live in .git/ and travel with it.
      if [ -n "$keyfile" ]; then
        if ! (cd "$tmp_dir/vault" && git-crypt unlock "$keyfile" >/dev/null 2>&1); then
          err "git-crypt unlock failed — wrong key file for this vault?"
          rm -rf "$tmp_dir"
          if [ -n "$pair_tmp_key" ]; then rm -f "$pair_tmp_key"; fi
          return 1
        fi
      fi
      mv "$tmp_dir/vault/.git" "$RADIOHEADER_DIR/.git"
      rm -rf "$tmp_dir"

      cd "$RADIOHEADER_DIR"
      git config pull.rebase false
      _sync_git_identity

      # Adopt, don't overwrite: files that exist only in the vault are checked
      # out; files that also exist locally keep the LOCAL version (committed on
      # top — the vault's copy stays in history).
      local missing
      missing=$(git ls-files -d 2>/dev/null || true)
      if [ -n "$missing" ]; then
        git ls-files -d -z 2>/dev/null | xargs -0 git checkout -q -- 2>/dev/null || true
      fi

      if [ -n "$keyfile" ]; then
        config_set device_sync_project_memories true
      fi
      _sync_write_git_meta
      _sync_untrack_ignored
      git add -A
      if ! git diff --cached --quiet 2>/dev/null; then
        git commit -q -m "device-sync: join ($host_label)"
      fi
      if ! git pull --no-rebase --no-edit --autostash --quiet 2>/dev/null; then
        if [ -f "$RADIOHEADER_DIR/.git/MERGE_HEAD" ]; then
          git merge --abort 2>/dev/null || true
          warn "Merge conflict with the vault — local state kept, sync deferred."
        fi
      fi
      git push --quiet 2>/dev/null || warn "Push failed — will retry on next sync."

      _sync_write_hook_script
      _sync_hooks_json register
      config_set device_sync_enabled true

      # One foreground reconcile so encrypted project memories (if --key)
      # land in ~/.claude/projects/*/memory/ right away.
      RH_SYNC_BG=1 "$SYNC_HOOK_PATH" push >/dev/null 2>&1 || true

      cmd_index >/dev/null 2>&1 || true
      ok "Joined vault. Search index rebuilt; run 'radioheader consolidate' to refresh the digest."
      if [ -n "$keyfile" ]; then
        ok "Encrypted project memories unlocked and distributed."
        if [ -n "$pair_tmp_key" ]; then
          echo -e "  ${YELLOW}Back up the key offline now${NC}: radioheader device-sync key export"
        else
          echo -e "  ${YELLOW}Keep an offline backup of the key file${NC} — losing it makes the vault's ciphertext unrecoverable."
        fi
      fi
      if [ -n "$pair_tmp_key" ]; then rm -f "$pair_tmp_key"; fi
      case "$pairfile" in
        "$SYNC_ICLOUD_DIR"/*)
          rm -f "$pairfile" 2>/dev/null || true
          info "Pairing bundle removed from iCloud (single-use)."
          ;;
      esac
      ;;

    encrypt)
      if ! _sync_enabled || [ ! -d "$RADIOHEADER_DIR/.git" ]; then
        err "Device sync is not set up yet. Run 'radioheader device-sync init' first."
        return 1
      fi
      if ! command -v git-crypt >/dev/null 2>&1; then
        err "git-crypt is required for encrypted project-memory sync."
        echo "  Install: brew install git-crypt"
        return 1
      fi
      cd "$RADIOHEADER_DIR"
      if [ ! -f .git/git-crypt/keys/default ]; then
        # Wrong-key guard: if the vault already holds ciphertext, generating a
        # NEW key here could never decrypt it — the key must come from an
        # already-unlocked machine instead.
        if git ls-files -- project-memories/ 2>/dev/null | grep -q .; then
          err "The vault already contains encrypted project memories."
          echo "  Copy the key from an unlocked machine (via SSH/AirDrop — never through the vault):"
          echo "    other machine:  radioheader device-sync key export"
          echo "    this machine:   radioheader device-sync key import <keyfile>"
          return 1
        fi
        if ! git-crypt init >/dev/null 2>&1; then
          err "git-crypt init failed."
          return 1
        fi
      fi
      config_set device_sync_project_memories true
      _sync_write_git_meta
      _sync_write_hook_script
      git add -A
      git diff --cached --quiet 2>/dev/null || git commit -q -m "device-sync: enable encrypted project-memory sync ($host_label)"
      git push --quiet 2>/dev/null || true

      ok "Encrypted project-memory sync enabled (staged under project-memories/, ciphertext in the vault)."
      echo ""
      echo -e "  ${YELLOW}⚠ BACK UP THE KEY NOW${NC} — losing it makes the vault's ciphertext unrecoverable:"
      echo "    radioheader device-sync key export    # store offline (e.g. password manager)"
      echo ""
      echo "  Other machines:  radioheader device-sync key import <keyfile>   (transfer the key"
      echo "  out-of-band: SSH/AirDrop — never commit it or send it through the vault)"
      echo "  First sync:      radioheader device-sync now"
      ;;

    key)
      local sub="${2:-}"
      case "$sub" in
        export)
          local out="${3:-$HOME/radioheader-vault.key}"
          case "$out" in /*) ;; *) out="$PWD/$out" ;; esac
          command -v git-crypt >/dev/null 2>&1 || { err "git-crypt is not installed."; return 1; }
          if [ ! -f "$RADIOHEADER_DIR/.git/git-crypt/keys/default" ]; then
            err "This machine is not unlocked — nothing to export."
            echo "  Run 'radioheader device-sync encrypt' (first machine) or 'key import' first."
            return 1
          fi
          if (cd "$RADIOHEADER_DIR" && git-crypt export-key "$out" 2>/dev/null); then
            chmod 600 "$out"
            ok "Key exported to $out"
            echo -e "  ${YELLOW}Handle with care:${NC} transfer out-of-band only (SSH/AirDrop), keep an"
            echo "  offline backup, never commit it — losing every copy means the vault's"
            echo "  encrypted project memories are gone forever."
          else
            err "Key export failed."
            return 1
          fi
          ;;
        import)
          local keyfile="${3:-}"
          if [ -z "$keyfile" ] || [ ! -f "$keyfile" ]; then
            err "Usage: radioheader device-sync key import <keyfile>"
            return 1
          fi
          case "$keyfile" in /*) ;; *) keyfile="$PWD/$keyfile" ;; esac
          command -v git-crypt >/dev/null 2>&1 || { err "git-crypt is not installed. Install: brew install git-crypt"; return 1; }
          if [ ! -d "$RADIOHEADER_DIR/.git" ]; then
            err "No sync repository. Run 'device-sync init' or 'device-sync join <url> --key <keyfile>' instead."
            return 1
          fi
          if (cd "$RADIOHEADER_DIR" && git-crypt unlock "$keyfile" >/dev/null 2>&1); then
            config_set device_sync_project_memories true
            _sync_write_git_meta
            _sync_write_hook_script
            ok "Vault unlocked — encrypted project-memory sync enabled on this machine."
            echo "  Run 'radioheader device-sync now' to distribute memories locally."
          else
            err "git-crypt unlock failed — wrong key, or uncommitted local changes."
            echo "  Try 'radioheader device-sync now' first (commits pending changes), then re-import."
            return 1
          fi
          ;;
        *)
          err "Usage: radioheader device-sync key [export [file] | import <file>]"
          return 1
          ;;
      esac
      ;;

    pair)
      local sub="${2:-export}"
      if [ "$sub" != "export" ]; then
        err "Usage: radioheader device-sync pair export [--icloud | --file <path>]"
        return 1
      fi
      if ! _sync_enabled || [ ! -d "$RADIOHEADER_DIR/.git" ]; then
        err "Device sync is not set up yet. Run 'radioheader device-sync init' first."
        return 1
      fi
      if ! git -C "$RADIOHEADER_DIR" remote get-url origin >/dev/null 2>&1; then
        err "No remote configured — run 'radioheader device-sync init --remote <url>' first."
        return 1
      fi

      shift 2 || true
      local pair_mode="file" pair_out="$HOME/Desktop/radioheader-pair.rhpair"
      while [ $# -gt 0 ]; do
        case "$1" in
          --icloud)  pair_mode="icloud"; shift ;;
          --file)    pair_out="${2:-}"; shift 2 || shift ;;
          --file=*)  pair_out="${1#--file=}"; shift ;;
          *)         err "Unknown option: $1"; return 1 ;;
        esac
      done

      if [ "$pair_mode" = "icloud" ]; then
        if ! _sync_openssl_ok; then
          err "This machine's openssl lacks -pbkdf2 (needed to encrypt the bundle)."
          echo "  Install a modern one: brew install openssl"
          return 1
        fi
        local pass
        if ! pass=$(_sync_pair_passphrase confirm); then
          err "Passphrases empty or did not match."
          return 1
        fi
        mkdir -p "$SYNC_ICLOUD_DIR"
        local pair_enc
        pair_enc=$(_sync_pair_payload | RH_PAIR_PASS="$pass" openssl enc -aes-256-cbc -pbkdf2 -salt -pass env:RH_PAIR_PASS 2>/dev/null | openssl base64 -A || true)
        if [ -z "$pair_enc" ]; then
          err "Failed to encrypt the pairing bundle."
          return 1
        fi
        {
          printf '%s-ENC\n' "$SYNC_PAIR_HEADER"
          printf 'host=%s\ncreated=%s\n' "$(_sync_host_label)" "$(date +%Y-%m-%d)"
          printf 'data=%s\n' "$pair_enc"
        } > "$SYNC_ICLOUD_DIR/pairing.rhpair"
        chmod 600 "$SYNC_ICLOUD_DIR/pairing.rhpair"
        ok "Encrypted pairing bundle written to iCloud Drive/RadioHeader/pairing.rhpair"
        echo "  On the other Mac (once iCloud syncs):"
        echo "    radioheader device-sync setup    → choose \"join\", enter the passphrase"
        echo "  The bundle is single-use: it is deleted automatically after a successful join."
      else
        case "$pair_out" in /*) ;; *) pair_out="$PWD/$pair_out" ;; esac
        mkdir -p "$(dirname "$pair_out")"
        _sync_pair_payload > "$pair_out"
        chmod 600 "$pair_out"
        ok "Pair file written: $pair_out"
        if grep -q '^key_b64=' "$pair_out" 2>/dev/null; then
          echo -e "  ${YELLOW}It contains the vault URL AND the encryption key${NC} — AirDrop it to your"
          echo "  other Mac, then DELETE it on both machines once joined."
        else
          echo "  It contains the vault URL (no encryption key). AirDrop it to your other Mac."
        fi
        echo "  On the other Mac:  radioheader device-sync setup   (or: device-sync join --pair <file>)"
      fi
      ;;

    setup)
      _sync_setup_wizard
      ;;

    now|push|pull)
      if ! _sync_enabled; then
        err "Device sync is not enabled. Run 'radioheader device-sync init' first."
        return 1
      fi
      if [ ! -d "$RADIOHEADER_DIR/.git" ]; then
        err "Not a git repository. Run 'radioheader device-sync init' first."
        return 1
      fi
      # Self-heal: rewrite the hook script if missing (e.g. hooks dir cleaned).
      [ -x "$SYNC_HOOK_PATH" ] || _sync_write_hook_script

      info "Reconciling with remote..."
      "$SYNC_HOOK_PATH" push || true

      if [ -f "$SYNC_DIVERGED_MARKER" ]; then
        warn "Sync deferred: real merge conflict with remote (local changes kept)."
        echo "  Resolve manually:"
        echo "    cd $RADIOHEADER_DIR && git pull --no-rebase   # fix conflicts"
        echo "    git add -A && git commit && git push"
      else
        ok "Sync complete."
      fi
      ;;

    status)
      echo ""
      echo -e "${BOLD}Device Sync Status${NC}"
      echo ""
      if _sync_enabled; then
        echo -e "  Enabled:  ${GREEN}yes${NC}"
      else
        echo -e "  Enabled:  ${DIM}no${NC} (radioheader device-sync init)"
      fi

      if [ ! -d "$RADIOHEADER_DIR/.git" ]; then
        echo -e "  Git:      ${DIM}not initialized${NC}"
        echo ""
        echo "  Set up with: radioheader device-sync init --remote <url>"
        echo ""
        return 0
      fi

      echo -e "  Git:      ${GREEN}initialized${NC}"
      local remote branch
      remote=$(git -C "$RADIOHEADER_DIR" remote get-url origin 2>/dev/null || echo "none")
      branch=$(git -C "$RADIOHEADER_DIR" branch --show-current 2>/dev/null || echo "unknown")
      echo -e "  Remote:   ${CYAN}$remote${NC}"
      echo -e "  Branch:   $branch"

      local counts behind ahead
      counts=$(git -C "$RADIOHEADER_DIR" rev-list --left-right --count '@{u}...HEAD' 2>/dev/null || true)
      if [ -n "$counts" ]; then
        behind=$(echo "$counts" | awk '{print $1}')
        ahead=$(echo "$counts" | awk '{print $2}')
        echo -e "  Upstream: ${YELLOW}$ahead${NC} to push, ${YELLOW}$behind${NC} to pull (as of last fetch)"
      else
        echo -e "  Upstream: ${DIM}not set${NC}"
      fi

      local changed
      changed=$(git -C "$RADIOHEADER_DIR" status --porcelain 2>/dev/null | wc -l | tr -d ' ')
      if [ "$changed" = "0" ]; then
        echo -e "  Worktree: ${GREEN}clean${NC}"
      else
        echo -e "  Worktree: ${YELLOW}$changed file(s) pending${NC} (picked up by next sync)"
      fi

      if grep -q "radioheader-git-sync.sh" "$SYNC_SETTINGS_JSON" 2>/dev/null; then
        echo -e "  Hooks:    ${GREEN}registered${NC} (SessionStart pull / Stop push)"
      else
        echo -e "  Hooks:    ${DIM}not registered${NC}"
      fi

      if [ "$(config_get device_sync_project_memories false)" = "true" ]; then
        if command -v git-crypt >/dev/null 2>&1 && [ -f "$RADIOHEADER_DIR/.git/git-crypt/keys/default" ]; then
          local pm_count tomb_count
          pm_count=$(find "$RADIOHEADER_DIR/project-memories" -name '*.md' -type f 2>/dev/null | wc -l | tr -d ' ')
          tomb_count=$(find "$RADIOHEADER_DIR/project-memories" -name '*.tombstone' -type f 2>/dev/null | wc -l | tr -d ' ')
          echo -e "  Memories: ${GREEN}encrypted sync on${NC} ($pm_count staged, $tomb_count tombstone(s))"
        else
          echo -e "  Memories: ${RED}enabled but locked${NC} — radioheader device-sync key import <keyfile>"
        fi
      else
        echo -e "  Memories: ${DIM}not synced${NC} (enable: radioheader device-sync encrypt)"
      fi

      if [ -f "$SYNC_DIVERGED_MARKER" ]; then
        echo ""
        echo -e "  ${RED}⚠ Sync deferred since $(cat "$SYNC_DIVERGED_MARKER" 2>/dev/null): real merge conflict.${NC}"
        echo "    Resolve: cd $RADIOHEADER_DIR && git pull --no-rebase  # fix, commit, push"
      fi
      if [ -d "$RADIOHEADER_DIR/.sync.lock" ]; then
        echo -e "  ${DIM}(a sync appears to be running right now)${NC}"
      fi
      echo ""
      ;;

    off)
      _sync_hooks_json unregister
      config_set device_sync_enabled false
      ok "Auto-sync disabled. Repository kept at $RADIOHEADER_DIR."
      echo "  Re-enable anytime with: radioheader device-sync init"
      ;;

    --help|-h)
      cat <<EOF
${BOLD}radioheader device-sync${NC} — Multi-machine sync of your RadioHeader data via git

${BOLD}USAGE${NC}
  radioheader device-sync [setup|init|join|encrypt|key|pair|now|status|off]

${BOLD}ACTIONS${NC}
  setup                  Interactive wizard — start here. Walks through first
                         machine / joining, repo creation, encryption, pairing
  init [--remote <url>]  Enable sync on this machine (creates/upgrades the git
                         repo in ~/.claude/radioheader/, installs auto-sync hooks)
  join <url> [--key <f>] First sync on an additional machine: adopt the remote
  join --pair <file>     vault, merge local data in (nothing is lost); --key
                         unlocks encrypted memories, --pair uses a pair bundle
  encrypt                Also sync ~/.claude/projects/*/memory/ — encrypted with
                         git-crypt (plaintext locally, ciphertext in the vault)
  key export [file]      Export the symmetric key (default ~/radioheader-vault.key)
  key import <file>      Unlock this machine with a key from another machine
  pair export            Pair bundle (URL + key) for the second Mac, to
                         ~/Desktop for AirDrop; --icloud writes a passphrase-
                         encrypted bundle to iCloud Drive/RadioHeader/ instead
  now                    Reconcile right now (also: push / pull — same thing)
  status                 Show sync health (default)
  off                    Disable auto-sync hooks (repo is kept; reversible)

${BOLD}HOW IT WORKS${NC}
  A git "sidecar" repo inside ~/.claude/radioheader/. Auto-sync runs on Claude
  session start (background pull) and session stop (push). Append-mostly files
  (topics/, shortwave/, INDEX.md) merge with union — two machines editing the
  same file both survive. Real conflicts never block: local wins, sync defers,
  'status' tells you. Project memories are staged under project-memories/ with
  usernames normalized (machines don't need the same login) and deletions
  propagate via tombstones — a file recreated after deletion wins.

${BOLD}WHAT SYNCS${NC}
  ✓ topics/  shortwave/  INDEX.md  user-profile.md
  ✓ project memories (opt-in via 'encrypt' — never plaintext in the vault)

${BOLD}WHAT STAYS LOCAL${NC} (rebuilt per machine)
  ✗ search.db (radioheader index)   ✗ context-digest.md / project-registry.*
  ✗ community/ (own clone)          ✗ config.json, logs, counters

${BOLD}SECURITY${NC}
  The git-crypt key travels out-of-band only (SSH/AirDrop), never through the
  vault. Keep an offline backup — losing every copy of the key makes the
  vault's ciphertext permanently unrecoverable. If any gate is off (no key,
  git-crypt missing), memory sync silently stays off; knowledge still syncs.

${BOLD}SETUP${NC}
  Easiest: run ${BOLD}radioheader device-sync setup${NC} on the first Mac, answer the
  prompts (it can create the GitHub repo for you), then run the same command
  on the other Mac. Nearby Macs pair via an AirDropped file; distant Macs via
  a passphrase-encrypted bundle in iCloud Drive.

  Manual equivalent:
  1. Create a PRIVATE repo (e.g. github.com/you/radioheader-vault)
  2. Machine A:  radioheader device-sync init --remote <url>
                 radioheader device-sync encrypt && radioheader device-sync pair export
  3. Machine B:  radioheader device-sync join --pair <airdropped-file>
  4. Done — syncs automatically with each Claude session.

EOF
      ;;

    *)
      err "Unknown action: $action"
      echo "Usage: radioheader device-sync [setup|init|join|encrypt|key|pair|now|status|off]"
      return 1
      ;;
  esac
}

# ============================================================
# upgrade — upgrade registered projects to latest templates
# ============================================================

# Known renames: old_name → new_name
# Add entries here when files are renamed in future versions
UPGRADE_RENAMES="memory-reflux.md:memory-echo.md"

cmd_upgrade() {
  local target="all"
  local dry_run=false

  # Parse flags
  while [ $# -gt 0 ]; do
    case "$1" in
      --dry-run) dry_run=true; shift ;;
      --help|-h)
        cat <<UPGRADEHELP

${BOLD}radioheader upgrade${NC} — Upgrade registered projects to latest templates

${BOLD}USAGE${NC}
  radioheader upgrade [project-name|all] [--dry-run]

${BOLD}OPTIONS${NC}
  project-name    Upgrade a specific project (by name in registry)
  all             Upgrade all registered projects (default)
  --dry-run       Show what would change without modifying files

${BOLD}WHAT IT DOES${NC}
  1. Renames outdated files (e.g. memory-reflux.md → memory-echo.md)
  2. Syncs runtime templates from the current RadioHeader repo
  3. Adds missing rule and runtime files from current templates
  4. Updates managed template contents (preserves __HOME__ etc.)
  5. Reports changes per project

${BOLD}EXAMPLES${NC}
  radioheader upgrade                  # Upgrade all projects
  radioheader upgrade MyApp            # Upgrade one project
  radioheader upgrade --dry-run        # Preview changes

UPGRADEHELP
        return 0
        ;;
      -*)
        err "Unknown option: $1"
        return 1
        ;;
      *)
        target="$1"; shift
        ;;
    esac
  done

  if [ ! -f "$REGISTRY_JSON" ] && [ ! -f "$REGISTRY" ]; then
    err "No project registry found. Expected project-registry.json or project-registry.md."
    return 1
  fi

  if [ ! -d "$TEMPLATES_DIR" ]; then
    err "Templates not found at $TEMPLATES_DIR. Re-run install.sh."
    return 1
  fi

  echo ""
  echo -e "${BOLD}RadioHeader Upgrade${NC} (v${VERSION})"
  if [ "$dry_run" = true ]; then
    echo -e "${YELLOW}  DRY RUN — no files will be modified${NC}"
  fi
  echo ""

  # --- Step 0: Sync templates from repo if available ---
  local script_path
  script_path=$(cd "$(dirname "$0")" && pwd)
  local repo_templates="$script_path/templates/project"
  if [ -d "$repo_templates" ]; then
    local synced=0

    local repo_file
    for repo_file in \
      "$repo_templates/CLAUDE.md.template" \
      "$repo_templates/AGENTS.md.template" \
      "$repo_templates/dot-claude/settings.json" \
      "$repo_templates/dot-codex/hooks.json" \
      "$repo_templates/dot-claude/hooks/load-project-rules.sh" \
      "$repo_templates/dot-codex/hooks/load-project-rules.sh"
    do
      [ -f "$repo_file" ] || continue
      local rel
      rel="${repo_file#$repo_templates/}"
      if [ ! -f "$TEMPLATES_DIR/$rel" ] || ! diff -q "$repo_file" "$TEMPLATES_DIR/$rel" >/dev/null 2>&1; then
        if [ "$dry_run" = true ]; then
          echo -e "  ${YELLOW}↻${NC} Would sync template: $rel"
        else
          mkdir -p "$(dirname "$TEMPLATES_DIR/$rel")"
          cp "$repo_file" "$TEMPLATES_DIR/$rel"
        fi
        synced=$((synced + 1))
      fi
    done

    for tmpl in "$repo_templates/dot-claude/rules"/*.md; do
      [ -f "$tmpl" ] || continue
      local fname
      fname=$(basename "$tmpl")
      if [ ! -f "$TEMPLATES_DIR/dot-claude/rules/$fname" ] || ! diff -q "$tmpl" "$TEMPLATES_DIR/dot-claude/rules/$fname" >/dev/null 2>&1; then
        if [ "$dry_run" = true ]; then
          echo -e "  ${YELLOW}↻${NC} Would sync template: rules/$fname"
        else
          mkdir -p "$TEMPLATES_DIR/dot-claude/rules"
          cp "$tmpl" "$TEMPLATES_DIR/dot-claude/rules/$fname"
        fi
        synced=$((synced + 1))
      fi
    done
    # Remove templates that no longer exist in repo
    if [ -d "$TEMPLATES_DIR/dot-claude/rules" ]; then
      for installed in "$TEMPLATES_DIR/dot-claude/rules"/*.md; do
        local fname
        fname=$(basename "$installed")
        if [ ! -f "$repo_templates/dot-claude/rules/$fname" ]; then
          if [ "$dry_run" = true ]; then
            echo -e "  ${YELLOW}✗${NC} Would remove obsolete template: rules/$fname"
          else
            rm "$installed"
          fi
          synced=$((synced + 1))
        fi
      done
    fi
    if [ -d "$repo_templates/dot-codex/hooks" ]; then
      for tmpl in "$repo_templates/dot-codex/hooks"/*; do
        [ -f "$tmpl" ] || continue
        local fname
        fname=$(basename "$tmpl")
        if [ ! -f "$TEMPLATES_DIR/dot-codex/hooks/$fname" ] || ! diff -q "$tmpl" "$TEMPLATES_DIR/dot-codex/hooks/$fname" >/dev/null 2>&1; then
          if [ "$dry_run" = true ]; then
            echo -e "  ${YELLOW}↻${NC} Would sync template: dot-codex/hooks/$fname"
          else
            mkdir -p "$TEMPLATES_DIR/dot-codex/hooks"
            cp "$tmpl" "$TEMPLATES_DIR/dot-codex/hooks/$fname"
          fi
          synced=$((synced + 1))
        fi
      done
    fi
    if [ "$synced" -gt 0 ]; then
      if [ "$dry_run" = false ]; then
        ok "Synced $synced template(s) from repo"
      fi
    else
      echo -e "  ${GREEN}✓${NC} Templates already up to date"
    fi
    echo ""
  fi

  local total_projects=0
  local upgraded_projects=0
  local total_changes=0
  local total_drift=0
  local project_entries=""
  local registry_entries_tmp
  registry_entries_tmp=$(mktemp)

  if [ -f "$REGISTRY_JSON" ]; then
    python3 - "$REGISTRY_JSON" > "$registry_entries_tmp" <<'PY'
import json
import sys

with open(sys.argv[1]) as f:
    data = json.load(f)

for project in data.get("projects", []):
    name = (project.get("name") or "").strip()
    path = (project.get("path") or "").strip()
    tech = (project.get("tech_stack") or "").strip()
    if name and path:
        print(f"{name}\t{path}\t{tech}")
PY
  elif [ -f "$REGISTRY" ]; then
    python3 - "$REGISTRY" > "$registry_entries_tmp" <<'PY'
from pathlib import Path
import sys

home = str(Path.home())

for raw in open(sys.argv[1]):
    if not raw.startswith("|"):
        continue
    parts = [part.strip().strip("`") for part in raw.split("|")[1:-1]]
    if len(parts) < 3:
        continue
    name, tech, path = parts[0], parts[1], parts[2]
    if not name or name.startswith("*(") or "project" in name.lower() or set(name) == {"-"}:
        continue
    if path.startswith("~/"):
        path = home + path[1:]
    if path:
        print(f"{name}\t{path}\t{tech}")
PY
  fi
  project_entries=$(cat "$registry_entries_tmp")
  rm -f "$registry_entries_tmp"

  # Read registry and process each project
  while IFS=$'\t' read -r pname ppath ptech; do
    [ -z "$pname" ] && continue
    [ -z "$ppath" ] && continue

    # Filter by target
    if [ "$target" != "all" ] && [ "$pname" != "$target" ]; then
      continue
    fi

    # Check if project path exists
    if [ ! -d "$ppath" ]; then
      echo -e "  ${DIM}⏭ $pname — path not found, skipping${NC}"
      continue
    fi

    # Check if project has .claude/rules/
    local rules_dir="$ppath/.claude/rules"
    if [ ! -d "$rules_dir" ]; then
      echo -e "  ${DIM}⏭ $pname — no .claude/rules/, not an initialized project${NC}"
      continue
    fi

    local has_claude=false
    local has_codex=false
    if [ -f "$ppath/CLAUDE.md" ] || [ -f "$ppath/.claude/settings.json" ]; then
      has_claude=true
    fi
    if [ -f "$ppath/AGENTS.md" ] || [ -f "$ppath/.codex/hooks.json" ]; then
      has_codex=true
    fi
    local metadata_source=""
    local project_tech_stack="${ptech:-Unknown}"
    local project_terminology="None"
    local project_doc_dir="projectBasicInfo"
    if [ -f "$ppath/CLAUDE.md" ]; then
      metadata_source="$ppath/CLAUDE.md"
    elif [ -f "$ppath/AGENTS.md" ]; then
      metadata_source="$ppath/AGENTS.md"
    fi
    if [ -n "$metadata_source" ]; then
      local parsed_stack
      parsed_stack=$(sed -n 's/^- Tech stack: //p' "$metadata_source" | head -n 1)
      [ -n "$parsed_stack" ] && project_tech_stack="$parsed_stack"
      local parsed_terms
      parsed_terms=$(sed -n 's/^- Terminology: //p' "$metadata_source" | head -n 1)
      [ -n "$parsed_terms" ] && project_terminology="$parsed_terms"
      local parsed_doc_dir
      parsed_doc_dir=$(sed -n 's|.*`\([^`]*\)/00_AGENT_RULES.md`.*|\1|p' "$metadata_source" | head -n 1)
      [ -n "$parsed_doc_dir" ] && project_doc_dir="$parsed_doc_dir"
    fi

    total_projects=$((total_projects + 1))
    local project_changes=0
    local project_drift=0

    echo -e "  ${BOLD}$pname${NC} ($ppath)"

    # --- Step 1: Handle renames ---
    local rename_entry
    for rename_entry in $UPGRADE_RENAMES; do
      local old_name="${rename_entry%%:*}"
      local new_name="${rename_entry##*:}"
      if [ -f "$rules_dir/$old_name" ] && [ ! -f "$rules_dir/$new_name" ]; then
        if [ "$dry_run" = true ]; then
          echo -e "    ${YELLOW}→${NC} Would rename: $old_name → $new_name"
        else
          mv "$rules_dir/$old_name" "$rules_dir/$new_name"
          echo -e "    ${GREEN}✓${NC} Renamed: $old_name → $new_name"
        fi
        project_changes=$((project_changes + 1))
      fi
    done

    # --- Step 2: Add missing rule files ---
    local template_rules_dir="$TEMPLATES_DIR/dot-claude/rules"
    if [ -d "$template_rules_dir" ]; then
      for tmpl_file in "$template_rules_dir"/*.md; do
        local fname
        fname=$(basename "$tmpl_file")
        if [ ! -f "$rules_dir/$fname" ]; then
          if [ "$dry_run" = true ]; then
            echo -e "    ${YELLOW}+${NC} Would add missing: $fname"
          else
            cp "$tmpl_file" "$rules_dir/$fname"
            sedi "s|__HOME__|$HOME|g" "$rules_dir/$fname"
            sedi "s|__DOC_DIR__|$project_doc_dir|g" "$rules_dir/$fname"
            echo -e "    ${GREEN}+${NC} Added missing: $fname"
          fi
          project_changes=$((project_changes + 1))
        fi
      done
    fi

    # --- Step 3: Report rule file drift (never overwrite customizations) ---
    # Rules files are per-project behavioral rules. Users may customize them
    # with project-specific guidance. We never silently overwrite; instead we
    # warn when drift is detected so the user can resolve it intentionally
    # (e.g. delete the file and re-run upgrade to accept the new template,
    # or manually merge in the changes they want).
    for rule_file in "$rules_dir"/*.md; do
      local fname
      fname=$(basename "$rule_file")
      local tmpl="$template_rules_dir/$fname"
      if [ -f "$tmpl" ]; then
        local expected
        expected=$(sed -e "s|__HOME__|$HOME|g" -e "s|__DOC_DIR__|$project_doc_dir|g" "$tmpl")
        local actual
        actual=$(cat "$rule_file")
        if [ "$expected" != "$actual" ]; then
          echo -e "    ${YELLOW}!${NC} Drift in $fname (customized or stale) — left unchanged"
          echo -e "      ${DIM}To accept the new template: rm .claude/rules/$fname && radioheader upgrade${NC}"
          project_drift=$((project_drift + 1))
        fi
      fi
    done

    # --- Step 4: Sync .claude/hooks ---
    local hooks_dir="$ppath/.claude/hooks"
    if [ "$has_claude" = true ] && [ -d "$TEMPLATES_DIR/dot-claude/hooks" ]; then
      for tmpl_hook in "$TEMPLATES_DIR/dot-claude/hooks"/*.sh; do
        [ -f "$tmpl_hook" ] || continue
        local hname
        hname=$(basename "$tmpl_hook")
        if [ ! -f "$hooks_dir/$hname" ]; then
          if [ "$dry_run" = true ]; then
            echo -e "    ${YELLOW}+${NC} Would add missing hook: $hname"
          else
            mkdir -p "$hooks_dir"
            cp "$tmpl_hook" "$hooks_dir/$hname"
            chmod +x "$hooks_dir/$hname"
            echo -e "    ${GREEN}+${NC} Added missing hook: $hname"
          fi
          project_changes=$((project_changes + 1))
        elif ! diff -q "$tmpl_hook" "$hooks_dir/$hname" >/dev/null 2>&1; then
          if [ "$dry_run" = true ]; then
            echo -e "    ${YELLOW}↻${NC} Would update hook: $hname"
          else
            cp "$tmpl_hook" "$hooks_dir/$hname"
            chmod +x "$hooks_dir/$hname"
            echo -e "    ${GREEN}↻${NC} Updated hook: $hname"
          fi
          project_changes=$((project_changes + 1))
        fi
      done
    fi

    # --- Step 5: Add missing runtime entry files (never overwrite existing) ---
    # CLAUDE.md / AGENTS.md / settings.json / hooks.json may contain user
    # customizations (extra index entries, custom hook commands, local notes).
    # Upgrade only fills in files that are missing; it never rewrites an
    # existing file, even if the content differs from the current template.
    if [ "$has_claude" = true ] && [ -f "$TEMPLATES_DIR/CLAUDE.md.template" ]; then
      if [ ! -f "$ppath/CLAUDE.md" ]; then
        if [ "$dry_run" = true ]; then
          echo -e "    ${YELLOW}+${NC} Would add missing: CLAUDE.md"
        else
          cp "$TEMPLATES_DIR/CLAUDE.md.template" "$ppath/CLAUDE.md"
          sedi "s|__PROJECT_NAME__|$pname|g" "$ppath/CLAUDE.md"
          sedi "s|__TECH_STACK__|$project_tech_stack|g" "$ppath/CLAUDE.md"
          sedi "s|__TERMINOLOGY__|$project_terminology|g" "$ppath/CLAUDE.md"
          sedi "s|__DOC_DIR__|$project_doc_dir|g" "$ppath/CLAUDE.md"
          echo -e "    ${GREEN}+${NC} Added missing: CLAUDE.md"
        fi
        project_changes=$((project_changes + 1))
      fi

      if [ -f "$TEMPLATES_DIR/dot-claude/settings.json" ] && [ ! -f "$ppath/.claude/settings.json" ]; then
        if [ "$dry_run" = true ]; then
          echo -e "    ${YELLOW}+${NC} Would add missing: .claude/settings.json"
        else
          mkdir -p "$ppath/.claude"
          cp "$TEMPLATES_DIR/dot-claude/settings.json" "$ppath/.claude/settings.json"
          echo -e "    ${GREEN}+${NC} Added missing: .claude/settings.json"
        fi
        project_changes=$((project_changes + 1))
      fi
    fi

    if [ "$has_codex" = true ] && [ -f "$TEMPLATES_DIR/AGENTS.md.template" ]; then
      if [ ! -f "$ppath/AGENTS.md" ]; then
        if [ "$dry_run" = true ]; then
          echo -e "    ${YELLOW}+${NC} Would add missing: AGENTS.md"
        else
          cp "$TEMPLATES_DIR/AGENTS.md.template" "$ppath/AGENTS.md"
          sedi "s|__PROJECT_NAME__|$pname|g" "$ppath/AGENTS.md"
          sedi "s|__TECH_STACK__|$project_tech_stack|g" "$ppath/AGENTS.md"
          sedi "s|__TERMINOLOGY__|$project_terminology|g" "$ppath/AGENTS.md"
          sedi "s|__DOC_DIR__|$project_doc_dir|g" "$ppath/AGENTS.md"
          echo -e "    ${GREEN}+${NC} Added missing: AGENTS.md"
        fi
        project_changes=$((project_changes + 1))
      fi

      if [ -f "$TEMPLATES_DIR/dot-codex/hooks.json" ] && [ ! -f "$ppath/.codex/hooks.json" ]; then
        if [ "$dry_run" = true ]; then
          echo -e "    ${YELLOW}+${NC} Would add missing: .codex/hooks.json"
        else
          mkdir -p "$ppath/.codex"
          cp "$TEMPLATES_DIR/dot-codex/hooks.json" "$ppath/.codex/hooks.json"
          echo -e "    ${GREEN}+${NC} Added missing: .codex/hooks.json"
        fi
        project_changes=$((project_changes + 1))
      fi

      local codex_hooks_dir="$ppath/.codex/hooks"
      if [ -d "$TEMPLATES_DIR/dot-codex/hooks" ]; then
        for tmpl_hook in "$TEMPLATES_DIR/dot-codex/hooks"/*; do
          [ -f "$tmpl_hook" ] || continue
          local hname
          hname=$(basename "$tmpl_hook")
          if [ ! -f "$codex_hooks_dir/$hname" ]; then
            if [ "$dry_run" = true ]; then
              echo -e "    ${YELLOW}+${NC} Would add missing hook: .codex/hooks/$hname"
            else
              mkdir -p "$codex_hooks_dir"
              cp "$tmpl_hook" "$codex_hooks_dir/$hname"
              chmod +x "$codex_hooks_dir/$hname"
              echo -e "    ${GREEN}+${NC} Added missing hook: .codex/hooks/$hname"
            fi
            project_changes=$((project_changes + 1))
          elif ! diff -q "$tmpl_hook" "$codex_hooks_dir/$hname" >/dev/null 2>&1; then
            if [ "$dry_run" = true ]; then
              echo -e "    ${YELLOW}↻${NC} Would update hook: .codex/hooks/$hname"
            else
              mkdir -p "$codex_hooks_dir"
              cp "$tmpl_hook" "$codex_hooks_dir/$hname"
              chmod +x "$codex_hooks_dir/$hname"
              echo -e "    ${GREEN}↻${NC} Updated hook: .codex/hooks/$hname"
            fi
            project_changes=$((project_changes + 1))
          fi
        done
      fi
    fi

    if [ "$project_changes" -eq 0 ] && [ "$project_drift" -eq 0 ]; then
      echo -e "    ${GREEN}✓${NC} Already up to date"
    elif [ "$project_changes" -eq 0 ]; then
      echo -e "    ${YELLOW}✓${NC} No structural changes; $project_drift customized rule file(s) left as-is"
      total_drift=$((total_drift + project_drift))
    else
      upgraded_projects=$((upgraded_projects + 1))
      total_changes=$((total_changes + project_changes))
      total_drift=$((total_drift + project_drift))
    fi

  done <<< "$project_entries"

  # --- Summary ---
  echo ""
  if [ "$total_projects" -eq 0 ]; then
    if [ "$target" = "all" ]; then
      warn "No initialized projects found in registry."
    else
      err "Project '$target' not found in registry."
    fi
  elif [ "$dry_run" = true ]; then
    echo -e "${BOLD}Dry run complete:${NC} $total_changes change(s) across $upgraded_projects of $total_projects project(s)"
    if [ "$total_drift" -gt 0 ]; then
      echo -e "${YELLOW}$total_drift customized rule file(s) detected — left unchanged.${NC}"
    fi
    echo -e "${DIM}Run without --dry-run to apply.${NC}"
  elif [ "$total_changes" -eq 0 ]; then
    if [ "$total_drift" -gt 0 ]; then
      echo -e "${GREEN}All $total_projects project(s) are structurally up to date.${NC}"
      echo -e "${YELLOW}$total_drift customized rule file(s) detected — review warnings above.${NC}"
    else
      echo -e "${GREEN}All $total_projects project(s) are up to date.${NC}"
    fi
  else
    echo -e "${GREEN}Upgraded $upgraded_projects project(s) with $total_changes change(s).${NC}"
    if [ "$total_drift" -gt 0 ]; then
      echo -e "${YELLOW}$total_drift customized rule file(s) left as-is — review warnings above.${NC}"
    fi
  fi
  echo ""
}

# ============================================================
# learn — extract web article into shortwave
# ============================================================

WEBEXTRACT_DIR="$CLAUDE_DIR/skills/web-extract"
WEBEXTRACT_VENV="$WEBEXTRACT_DIR/.venv"
WEBEXTRACT_SCRIPT="$WEBEXTRACT_DIR/scrapling_fetch.py"

cmd_learn() {
  local url=""
  local topic=""
  local max_chars=30000

  # Parse arguments
  while [ $# -gt 0 ]; do
    case "$1" in
      --topic)  topic="$2"; shift 2 ;;
      --max-chars) max_chars="$2"; shift 2 ;;
      --help|-h)
        cat <<LEARNHELP

${BOLD}radioheader learn${NC} — Extract web article and generate shortwave entry

${BOLD}USAGE${NC}
  radioheader learn <url> [--topic <topic-name>]

${BOLD}OPTIONS${NC}
  --topic <name>    Also update the specified topic file in topics/
  --max-chars <n>   Max characters to extract (default: 30000)

${BOLD}EXAMPLES${NC}
  radioheader learn https://example.com/article
  radioheader learn https://mp.weixin.qq.com/s/xxx --topic ai-api-integration

${BOLD}REQUIREMENTS${NC}
  web-extract skill must be installed at ~/.claude/skills/web-extract/
  Run 'radioheader doctor' to check status.

${BOLD}WHAT THIS DOES${NC}
  1. Extracts clean article text from any URL (3-tier: Jina → Scrapling → web_fetch)
  2. Outputs the extracted markdown for Claude to distill into a shortwave entry
  3. Claude decides if the content has value and writes the shortwave automatically

  This gives RadioHeader a second knowledge channel: not just learning from mistakes
  (Echo), but actively absorbing knowledge from external articles.

LEARNHELP
        return 0
        ;;
      -*)
        err "Unknown option: $1"
        return 1
        ;;
      *)
        if [ -z "$url" ]; then
          url="$1"
        fi
        shift
        ;;
    esac
  done

  if [ -z "$url" ]; then
    err "Usage: radioheader learn <url> [--topic <topic-name>]"
    echo "  Run 'radioheader learn --help' for details."
    return 1
  fi

  # --- Check dependencies ---
  if [ ! -d "$WEBEXTRACT_DIR" ]; then
    echo ""
    echo -e "${YELLOW}web-extract skill is not installed.${NC}"
    echo ""
    echo "  The 'learn' command needs the web-extract skill to fetch articles from any URL."
    echo "  This skill also enhances Claude Code itself — giving it the ability to:"
    echo ""
    echo "    • Read articles from walled gardens (WeChat, Medium, Substack)"
    echo "    • Extract clean text from any webpage, saving 60-70% tokens vs raw web_fetch"
    echo "    • Bypass common anti-scraping measures (Cloudflare, bot detection)"
    echo ""
    echo "  To install:"
    echo "    1. Create directory: mkdir -p ~/.claude/skills/web-extract"
    echo "    2. Copy SKILL.md and scrapling_fetch.py from the RadioHeader repo:"
    echo "       cp radioheader/templates/skills/web-extract/* ~/.claude/skills/web-extract/"
    echo "    3. Set up Python venv:"
    echo "       python3 -m venv ~/.claude/skills/web-extract/.venv"
    echo "       ~/.claude/skills/web-extract/.venv/bin/pip install scrapling html2text browserforge"
    echo ""
    return 1
  fi

  if [ ! -f "$WEBEXTRACT_SCRIPT" ]; then
    err "scrapling_fetch.py not found at $WEBEXTRACT_SCRIPT"
    echo "  Reinstall the web-extract skill."
    return 1
  fi

  if [ ! -d "$WEBEXTRACT_VENV" ]; then
    echo ""
    echo -e "${YELLOW}Python venv not found for web-extract skill.${NC}"
    echo ""
    echo "  Set up the venv:"
    echo "    python3 -m venv ~/.claude/skills/web-extract/.venv"
    echo "    ~/.claude/skills/web-extract/.venv/bin/pip install scrapling html2text browserforge"
    echo ""
    return 1
  fi

  # --- Determine extraction strategy based on domain ---
  local strategy="auto"
  local domain=""
  domain=$(echo "$url" | sed 's|https\{0,1\}://||' | sed 's|/.*||' | sed 's|www\.||')

  case "$domain" in
    mp.weixin.qq.com)
      strategy="scrapling"
      info "WeChat article detected → using Scrapling directly (Jina gets 403)"
      ;;
    github.com|raw.githubusercontent.com)
      strategy="webfetch"
      info "GitHub URL → web_fetch is sufficient"
      ;;
    *.readthedocs.io)
      strategy="webfetch"
      info "Docs site → web_fetch is sufficient"
      ;;
    *)
      info "Trying Jina Reader first, with Scrapling fallback"
      ;;
  esac

  echo ""

  # --- Tier 1: Jina Reader (unless domain-routed elsewhere) ---
  local content=""
  local tier_used=""
  local extract_ok=false

  if [ "$strategy" = "auto" ] || [ "$strategy" = "jina" ]; then
    info "Tier 1: Jina Reader..."
    local jina_url="https://r.jina.ai/$url"
    # Use curl to fetch Jina (simpler than requiring web_fetch tool)
    content=$(curl -sL --max-time 15 -H "Accept: text/markdown" "$jina_url" 2>/dev/null | head -c "$max_chars")

    if [ -n "$content" ] && [ "${#content}" -gt 100 ]; then
      # Check for common failure patterns
      if echo "$content" | grep -qi "环境异常\|403 Forbidden\|Access Denied\|Rate limit\|404 Not Found\|returned error"; then
        warn "Jina returned error/block page, falling back..."
        content=""
      elif [ "${#content}" -lt 200 ]; then
        warn "Jina returned too little content (${#content} chars), falling back..."
        content=""
      else
        tier_used="jina"
        extract_ok=true
      fi
    fi
  fi

  # --- Tier 2: Scrapling ---
  if [ "$extract_ok" = false ] && [ "$strategy" != "webfetch" ]; then
    info "Tier 2: Scrapling + html2text..."
    local scrapling_result
    scrapling_result=$("$WEBEXTRACT_VENV/bin/python3" "$WEBEXTRACT_SCRIPT" "$url" "$max_chars" 2>/dev/null)

    # Parse JSON result
    local scrapling_ok
    scrapling_ok=$(echo "$scrapling_result" | python3 -c "import sys,json; d=json.load(sys.stdin); print('true' if d.get('ok') else 'false')" 2>/dev/null || echo "false")

    if [ "$scrapling_ok" = "true" ]; then
      content=$(echo "$scrapling_result" | python3 -c "import sys,json; print(json.load(sys.stdin).get('content',''))" 2>/dev/null)
      tier_used=$(echo "$scrapling_result" | python3 -c "import sys,json; print(json.load(sys.stdin).get('mode','scrapling'))" 2>/dev/null)
      extract_ok=true
    else
      local scrapling_err
      scrapling_err=$(echo "$scrapling_result" | python3 -c "import sys,json; print(json.load(sys.stdin).get('error','unknown'))" 2>/dev/null || echo "extraction failed")
      warn "Scrapling failed: $scrapling_err"
    fi
  fi

  # --- Tier 3: curl fallback (simple text extraction) ---
  if [ "$extract_ok" = false ]; then
    info "Tier 3: curl direct fetch (noisy, full-page)..."
    content=$(curl -sL --max-time 15 "$url" 2>/dev/null | python3 -c "
import sys, html, re
raw = sys.stdin.read()
# Strip HTML tags, decode entities
text = re.sub(r'<script[^>]*>.*?</script>', '', raw, flags=re.DOTALL)
text = re.sub(r'<style[^>]*>.*?</style>', '', text, flags=re.DOTALL)
text = re.sub(r'<[^>]+>', ' ', text)
text = html.unescape(text)
text = re.sub(r'\s+', ' ', text).strip()
print(text[:$max_chars])
" 2>/dev/null)

    if [ -n "$content" ] && [ "${#content}" -gt 100 ]; then
      tier_used="curl-fallback"
      extract_ok=true
    fi
  fi

  if [ "$extract_ok" = false ]; then
    err "All three tiers failed to extract content from: $url"
    echo "  Try opening the URL in a browser and pasting the content manually."
    return 1
  fi

  # --- Output for Claude to process ---
  local char_count="${#content}"
  ok "Extracted ${char_count} characters using: ${tier_used}"
  echo ""

  # Write extracted content to a temp file for Claude to read
  local tmpfile
  tmpfile=$(mktemp /tmp/radioheader-learn-XXXXXX)
  mv "$tmpfile" "${tmpfile}.md"
  tmpfile="${tmpfile}.md"
  cat > "$tmpfile" <<EXTRACTHEADER
# Web Article Extraction

- **URL**: $url
- **Extraction tier**: $tier_used
- **Characters**: $char_count
- **Topic hint**: ${topic:-"(auto-detect)"}

---

EXTRACTHEADER
  echo "$content" >> "$tmpfile"

  echo -e "${BOLD}Extracted content saved to:${NC} $tmpfile"
  echo ""

  if [ -n "$topic" ]; then
    echo -e "${DIM}Topic hint: $topic — Claude will update topics/$topic.md if relevant${NC}"
  fi

  echo ""
  echo -e "${BOLD}Next step:${NC} In Claude Code, tell Claude:"
  echo ""
  echo -e "  ${CYAN}Read $tmpfile and distill valuable experience into a RadioHeader shortwave.${NC}"
  echo -e "  ${CYAN}Follow shortwave-spec format. Source tag: [来源:URL]${NC}"
  if [ -n "$topic" ]; then
    echo -e "  ${CYAN}Also update topics/$topic.md if applicable.${NC}"
  fi
  echo ""
  echo -e "${DIM}Claude will judge whether the content has shortwave-worthy experience.${NC}"
  echo -e "${DIM}If not, it will say so — no user confirmation needed.${NC}"
  echo ""
}

# ============================================================
# consolidate — update project attention weights
# ============================================================

cmd_consolidate() {
  local dry_run=false

  # Parse flags first (needed by both paths)
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --dry-run) dry_run=true; shift ;;
      --help|-h)
        cat <<EOF

${BOLD}radioheader consolidate${NC} — Update project attention weights

${BOLD}USAGE${NC}
  radioheader consolidate
  radioheader consolidate --dry-run

${BOLD}DESCRIPTION${NC}
  Analyzes search logs to update project attention weights.
  Like "sleep consolidation" in human memory — periodic compression
  of usage patterns into stable weights.

  When RadioMind is installed, consolidation is delegated to RadioMind's
  rh-consolidate, which adds dream refinement (SHY pruning + DMN
  wandering) and generates a richer context digest.

  Actions (native):
  - Update activity scores based on last_active decay
  - Count search hits per project from search-log.jsonl
  - Recalculate attention_weight for each project
  - Rebuild domain_index in project-registry.json
  - Generate human-readable project-registry.md
  - Trim search log to last 90 days

${BOLD}OPTIONS${NC}
  --dry-run    Show changes without modifying files

EOF
        return 0
        ;;
      *) shift ;;
    esac
  done

  # --- RadioMind enhanced consolidation ---
  if radiomind_available; then
    info "Using RadioMind for consolidation (dream refinement + digest)"
    warn "This calls an LLM and mutates the RadioMind store + context digest."
    local rm_args=("rh-consolidate")
    if [ "$dry_run" = true ]; then
      rm_args+=(--dry-run)
    fi
    if radiomind "${rm_args[@]}" 2>/dev/null; then
      return 0
    fi
    warn "RadioMind consolidation failed, falling back to native..."
  fi

  # --- Native consolidation ---
  local script
  script="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/attn-consolidate.py"

  if [ ! -f "$script" ]; then
    err "attn-consolidate.py not found at: $script"
    return 1
  fi

  local args=("$script")
  args+=(--radioheader-dir "$RADIOHEADER_DIR")
  if [ "$dry_run" = true ]; then
    args+=(--dry-run)
  fi

  python3 "${args[@]}"
}

# ============================================================
# Main — subcommand routing
# ============================================================

cmd_mcp_server() {
  # Exec the MCP server script installed next to this CLI binary. Users
  # configure their MCP client to run `radioheader mcp-server`, which is
  # stable even if the user later moves the data layer or renames the
  # install directory.
  local script_dir
  script_dir=$(cd "$(dirname "$0")" && pwd)
  local server="$script_dir/radioheader-mcp-server.py"
  if [ ! -f "$server" ]; then
    err "radioheader-mcp-server.py not found at $server"
    err "Re-run install.sh to install the MCP server script."
    return 1
  fi
  if ! command -v python3 &>/dev/null; then
    err "python3 is required to run the MCP server."
    return 1
  fi
  exec python3 "$server" "$@"
}

case "${1:-help}" in
  init)         shift; cmd_init "$@" ;;
  search)       shift; cmd_search "$@" ;;
  index)        shift; cmd_index "$@" ;;
  learn)        shift; cmd_learn "$@" ;;
  upgrade)      shift; cmd_upgrade "$@" ;;
  status)       cmd_status ;;
  doctor)       cmd_doctor ;;
  align)        shift; cmd_align "$@" ;;
  community)    shift; cmd_community "$@" ;;
  sync)         cmd_sync ;;
  publish)      shift; cmd_publish "$@" ;;
  vote)         shift; cmd_vote "$@" ;;
  device-sync)  shift; cmd_device_sync "$@" ;;
  consolidate)  shift; cmd_consolidate "$@" ;;
