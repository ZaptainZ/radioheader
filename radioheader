#!/bin/bash
set -e

# RadioHeader CLI — Cross-project experience sharing for Claude Code
# Usage: radioheader <command> [options]

VERSION="1.1.0"
CLAUDE_DIR="$HOME/.claude"
RADIOHEADER_DIR="$CLAUDE_DIR/radioheader"
TEMPLATES_DIR="$RADIOHEADER_DIR/templates/project"
TOPICS_DIR="$RADIOHEADER_DIR/topics"
SHORTWAVE_DIR="$RADIOHEADER_DIR/shortwave"
COMMUNITY_DIR="$RADIOHEADER_DIR/community"
COMMUNITY_POOL="$COMMUNITY_DIR/pool"
CONFIG_FILE="$RADIOHEADER_DIR/config.json"
PENDING_VOTES="$RADIOHEADER_DIR/pending-votes.jsonl"
REGISTRY="$RADIOHEADER_DIR/project-registry.md"
INDEX="$RADIOHEADER_DIR/INDEX.md"

# Default community repository (users can override in config.json)
DEFAULT_COMMUNITY_REPO="https://github.com/ZaptainZ/radioheader-community.git"

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
BOLD='\033[1m'
DIM='\033[2m'
NC='\033[0m'

info()  { echo -e "${BLUE}[RadioHeader]${NC} $1"; }
ok()    { echo -e "${GREEN}[RadioHeader]${NC} $1"; }
warn()  { echo -e "${YELLOW}[RadioHeader]${NC} $1"; }
err()   { echo -e "${RED}[RadioHeader]${NC} $1"; }

# ============================================================
# config helpers (JSON read/write without jq dependency)
# ============================================================

# Read a top-level string value from config.json
# Usage: config_get "key" [default]
config_get() {
  local key="$1"
  local default="${2:-}"
  if [ ! -f "$CONFIG_FILE" ]; then
    echo "$default"
    return
  fi
  # Simple JSON parser for flat key-value (no nested objects)
  local val
  val=$(grep "\"$key\"" "$CONFIG_FILE" 2>/dev/null | head -1 | sed 's/.*"'"$key"'"[[:space:]]*:[[:space:]]*//' | sed 's/[",]//g' | xargs)
  if [ -n "$val" ]; then
    echo "$val"
  else
    echo "$default"
  fi
}

# Write a top-level key-value to config.json
# Usage: config_set "key" "value"
config_set() {
  local key="$1"
  local value="$2"
  local config_path="$CONFIG_FILE"
  python3 -c "
import json, os
path = '$config_path'
d = {}
if os.path.exists(path):
    with open(path) as f:
        try: d = json.load(f)
        except: d = {}
v = '$value'
if v in ('true','false'): v = (v == 'true')
d['$key'] = v
with open(path,'w') as f:
    json.dump(d, f, indent=2, ensure_ascii=False)
    f.write('\n')
"
}

# Check if community is enabled
community_enabled() {
  local val
  val=$(config_get "community" "false")
  [ "$val" = "true" ]
}

# Get community repo URL
community_repo_url() {
  config_get "community_repo" "$DEFAULT_COMMUNITY_REPO"
}

# Cross-platform sed -i
sedi() {
  if [[ "$OSTYPE" == darwin* ]]; then
    sed -i '' "$@"
  else
    sed -i "$@"
  fi
}

