set -e

# RadioHeader CLI — Cross-project experience sharing for Claude Code and Codex
# Usage: radioheader <command> [options]

VERSION="2.3.0"
CLAUDE_DIR="$HOME/.claude"
RADIOHEADER_DIR="$CLAUDE_DIR/radioheader"
TEMPLATES_DIR="$RADIOHEADER_DIR/templates/project"
TOPICS_DIR="$RADIOHEADER_DIR/topics"
SHORTWAVE_DIR="$RADIOHEADER_DIR/shortwave"
COMMUNITY_DIR="$RADIOHEADER_DIR/community"
COMMUNITY_POOL="$COMMUNITY_DIR/pool"
CONFIG_FILE="$RADIOHEADER_DIR/config.json"
PENDING_VOTES="$RADIOHEADER_DIR/pending-votes.jsonl"
REGISTRY="$RADIOHEADER_DIR/project-registry.md"
REGISTRY_JSON="$RADIOHEADER_DIR/project-registry.json"
INDEX="$RADIOHEADER_DIR/INDEX.md"
CODEX_DIR="$HOME/.codex"
CODEX_AGENTS="$CODEX_DIR/AGENTS.md"
CODEX_HOOKS_JSON="$CODEX_DIR/hooks.json"

# Default community repository (users can override in config.json)
DEFAULT_COMMUNITY_REPO="https://github.com/ZaptainZ/radioheader-community.git"

# Resolve a Python 3.7+ interpreter (FTS5 search/index need `from __future__ import
# annotations`; some macOS users have a legacy /usr/local/bin/python3 3.6.x ahead
# of newer interpreters on PATH). Override via RH_PY_OVERRIDE env var.
_resolve_py3() {
  local p
  for p in "${RH_PY_OVERRIDE:-}" python3 /usr/bin/python3 /opt/homebrew/bin/python3 /usr/local/bin/python3.11 /usr/local/bin/python3.10 /usr/local/bin/python3.9; do
    [ -z "$p" ] && continue
    if command -v "$p" >/dev/null 2>&1 && "$p" -c 'import sys; sys.exit(0 if sys.version_info >= (3, 7) else 1)' 2>/dev/null; then
      echo "$p"
      return 0
    fi
  done
  echo "python3"
  return 1
}
RH_PY="$(_resolve_py3)"

# Colors — ANSI-C quoting ($'...') stores real escape bytes, so both
# `echo -e` lines AND `cat <<EOF` help texts render colors (plain '\033[...]'
# literals used to print raw escape codes in every heredoc help screen).
RED=$'\033[0;31m'
GREEN=$'\033[0;32m'
YELLOW=$'\033[1;33m'
BLUE=$'\033[0;34m'
CYAN=$'\033[0;36m'
BOLD=$'\033[1m'
DIM=$'\033[2m'
NC=$'\033[0m'

info()  { echo -e "${BLUE}[RadioHeader]${NC} $1"; }
ok()    { echo -e "${GREEN}[RadioHeader]${NC} $1"; }
warn()  { echo -e "${YELLOW}[RadioHeader]${NC} $1"; }
err()   { echo -e "${RED}[RadioHeader]${NC} $1"; }

radiomind_available() {
  command -v radiomind &>/dev/null
}

RADIOMIND_SUGGEST_FILE="$RADIOHEADER_DIR/.radiomind-suggested"
RADIOMIND_SUGGEST_COOLDOWN_DAYS=14

radiomind_suggest_due() {
  # Returns 0 (true) if we haven't suggested recently
  if radiomind_available; then
    return 1
  fi
  if [ ! -f "$RADIOMIND_SUGGEST_FILE" ]; then
    return 0
  fi
  local last_ts
  last_ts=$(cat "$RADIOMIND_SUGGEST_FILE" 2>/dev/null || echo "0")
  local now_ts
  now_ts=$(date +%s)
  local diff=$(( now_ts - last_ts ))
  local cooldown=$(( RADIOMIND_SUGGEST_COOLDOWN_DAYS * 86400 ))
  [ "$diff" -ge "$cooldown" ]
}

radiomind_mark_suggested() {
  date +%s > "$RADIOMIND_SUGGEST_FILE" 2>/dev/null || true
}

print_radiomind_suggestion() {
  echo ""
  echo -e "${BLUE}────────────────────────────────────────${NC}"
  echo -e "${BOLD}Enhance RadioHeader with RadioMind${NC}"
  echo ""
  echo "  RadioMind is a bionic memory core that reads your existing"
  echo "  RadioHeader data and adds:"
  echo ""
  echo "  • Enhanced search — pyramid retrieval + knowledge graph"
  echo "  • Active refinement — three-body debate strengthens entries"
  echo "  • Dream pruning — outdated entries auto-decay"
  echo "  • Works alongside RadioHeader — zero config, shared data layer"
  echo ""
  echo "  Install: pip install radiomind"
  echo "  Docs:    https://github.com/ZaptainZ/radiomind"
  echo -e "${BLUE}────────────────────────────────────────${NC}"
  echo ""
  radiomind_mark_suggested
}

project_runtime_summary() {
  local modes=()
  [ -f "CLAUDE.md" ] && modes+=("claude")
  [ -f "AGENTS.md" ] && modes+=("codex")
  if [ "${#modes[@]}" -eq 0 ]; then
    echo "none"
  else
    local joined="${modes[*]}"
    echo "${joined// /, }"
  fi
}

# ============================================================
# config helpers (JSON read/write without jq dependency)
# ============================================================

# Read a top-level string value from config.json
# Usage: config_get "key" [default]
config_get() {
  local key="$1"
  local default="${2:-}"
  if [ ! -f "$CONFIG_FILE" ]; then
    echo "$default"
    return
  fi
  # Simple JSON parser for flat key-value (no nested objects)
  local val
  val=$(grep "\"$key\"" "$CONFIG_FILE" 2>/dev/null | head -1 | sed 's/.*"'"$key"'"[[:space:]]*:[[:space:]]*//' | sed 's/[",]//g' | xargs)
  if [ -n "$val" ]; then
    echo "$val"
  else
    echo "$default"
  fi
}

# Write a top-level key-value to config.json
# Usage: config_set "key" "value"
config_set() {
  local key="$1"
  local value="$2"
  local config_path="$CONFIG_FILE"
  python3 -c "
import json, os
path = '$config_path'
d = {}
if os.path.exists(path):
    with open(path) as f:
        try: d = json.load(f)
        except: d = {}
v = '$value'
if v in ('true','false'): v = (v == 'true')
d['$key'] = v
with open(path,'w') as f:
    json.dump(d, f, indent=2, ensure_ascii=False)
    f.write('\n')
"
}

# Check if community is enabled
community_enabled() {
  local val
  val=$(config_get "community" "false")
  [ "$val" = "true" ]
}

# Get community repo URL
community_repo_url() {
  config_get "community_repo" "$DEFAULT_COMMUNITY_REPO"
}

# Cross-platform sed -i
sedi() {
  if [[ "$OSTYPE" == darwin* ]]; then
    sed -i '' "$@"
  else
    sed -i "$@"
  fi
}

