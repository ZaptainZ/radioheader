# ============================================================
# init
# ============================================================

cmd_init() {
  local project_name=""
  local tech_stack=""
  local doc_dir="projectBasicInfo"
  local terminology="(none)"
  local runtime="both"

  # Parse flags
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --name)     project_name="$2"; shift 2 ;;
      --stack)    tech_stack="$2"; shift 2 ;;
      --doc-dir)  doc_dir="$2"; shift 2 ;;
      --terms)    terminology="$2"; shift 2 ;;
      --runtime)  runtime="$2"; shift 2 ;;
      --help|-h)
        cat <<EOF
${BOLD}radioheader init${NC} — Initialize dynamic experience framework

${BOLD}FLAGS${NC}
  --name <name>     Project name (required)
  --stack <stack>    Tech stack, e.g. "iOS/SwiftUI" (required)
  --doc-dir <dir>   Documentation directory name (default: projectBasicInfo)
  --terms <terms>   Terminology mappings (optional)
  --runtime <mode>  claude | codex | both (default: both)

${BOLD}INTERACTIVE MODE${NC}
  Run without flags to be prompted for each value.

EOF
        return 0
        ;;
      *)
        err "Unknown flag: $1"
        return 1
        ;;
    esac
  done

  # Pre-checks
  if [ ! -d "$RADIOHEADER_DIR" ]; then
    err "RadioHeader is not installed. Run install.sh first."
    return 1
  fi

  case "$runtime" in
    claude|codex|both) ;;
    *)
      err "Invalid runtime: $runtime (expected claude, codex, or both)"
      return 1
      ;;
  esac

  if [ ! -d "$TEMPLATES_DIR" ]; then
    err "Project templates not found at $TEMPLATES_DIR"
    err "Re-run install.sh to install templates."
    return 1
  fi

  # Check if already initialized
  if [ -f ".claude/rules/memory-echo.md" ] || [ -f "CLAUDE.md" ] || [ -f "AGENTS.md" ]; then
    warn "This project appears to be already initialized."
    read -p "Re-initialize? Existing files will NOT be overwritten. [y/N] " -n 1 -r
    echo
    if [[ ! $REPLY =~ ^[Yy]$ ]]; then
      info "Aborted."
      return 0
    fi
  fi

  # Interactive mode if flags not provided
  if [ -z "$project_name" ]; then
    echo ""
    echo -e "${BOLD}RadioHeader Project Init${NC}"
    echo -e "${DIM}Setting up the dynamic experience framework for this project.${NC}"
    echo ""

    read -p "Project name: " project_name
    if [ -z "$project_name" ]; then
      err "Project name is required."
      return 1
    fi

    read -p "Tech stack (e.g. iOS/SwiftUI, Python/FastAPI): " tech_stack
    if [ -z "$tech_stack" ]; then
      err "Tech stack is required."
      return 1
    fi

    read -p "Documentation directory name [projectBasicInfo]: " input_doc_dir
    if [ -n "$input_doc_dir" ]; then
      doc_dir="$input_doc_dir"
    fi

    read -p "Terminology mappings (optional, press Enter to skip): " terminology
    if [ -z "$terminology" ]; then
      terminology="(none)"
    fi
  fi

  # Validate required fields
  if [ -z "$project_name" ] || [ -z "$tech_stack" ]; then
    err "Both --name and --stack are required."
    return 1
  fi

  echo ""
  info "Initializing project: ${BOLD}$project_name${NC}"
  info "Tech stack: $tech_stack"
  info "Doc directory: $doc_dir"
  info "Runtime: $runtime"

  # --- Create directory structure ---

  mkdir -p ".claude/hooks"
  mkdir -p ".claude/rules"
  mkdir -p ".codex/hooks"
  mkdir -p "$doc_dir/logs"

  # --- Copy and process template files ---

  # CLAUDE.md
  if [ "$runtime" = "claude" ] || [ "$runtime" = "both" ]; then
    if [ -f "CLAUDE.md" ]; then
      warn "CLAUDE.md already exists, skipping (not overwriting)"
    else
      cp "$TEMPLATES_DIR/CLAUDE.md.template" "CLAUDE.md"
      sedi "s|__PROJECT_NAME__|$project_name|g" "CLAUDE.md"
      sedi "s|__TECH_STACK__|$tech_stack|g" "CLAUDE.md"
      sedi "s|__TERMINOLOGY__|$terminology|g" "CLAUDE.md"
      sedi "s|__DOC_DIR__|$doc_dir|g" "CLAUDE.md"
      ok "Created CLAUDE.md"
    fi
  fi

  # AGENTS.md
  if [ "$runtime" = "codex" ] || [ "$runtime" = "both" ]; then
    if [ -f "AGENTS.md" ]; then
      warn "AGENTS.md already exists, skipping (not overwriting)"
    else
      cp "$TEMPLATES_DIR/AGENTS.md.template" "AGENTS.md"
      sedi "s|__PROJECT_NAME__|$project_name|g" "AGENTS.md"
      sedi "s|__TECH_STACK__|$tech_stack|g" "AGENTS.md"
      sedi "s|__TERMINOLOGY__|$terminology|g" "AGENTS.md"
      sedi "s|__DOC_DIR__|$doc_dir|g" "AGENTS.md"
      ok "Created AGENTS.md"
    fi
  fi

  # .claude/settings.json
  if [ "$runtime" = "claude" ] || [ "$runtime" = "both" ]; then
    if [ -f ".claude/settings.json" ]; then
      warn ".claude/settings.json already exists, skipping"
    else
      cp "$TEMPLATES_DIR/dot-claude/settings.json" ".claude/settings.json"
      ok "Created .claude/settings.json"
    fi
  fi

  # .codex/hooks.json
  if [ "$runtime" = "codex" ] || [ "$runtime" = "both" ]; then
    if [ -f ".codex/hooks.json" ]; then
      warn ".codex/hooks.json already exists, skipping"
    else
      cp "$TEMPLATES_DIR/dot-codex/hooks.json" ".codex/hooks.json"
      ok "Created .codex/hooks.json"
    fi
  fi

  # .claude/hooks/load-project-rules.sh
  if [ "$runtime" = "claude" ] || [ "$runtime" = "both" ]; then
    if [ -f ".claude/hooks/load-project-rules.sh" ]; then
      warn ".claude/hooks/load-project-rules.sh already exists, skipping"
    else
      cp "$TEMPLATES_DIR/dot-claude/hooks/load-project-rules.sh" ".claude/hooks/load-project-rules.sh"
      chmod +x ".claude/hooks/load-project-rules.sh"
      ok "Created .claude/hooks/load-project-rules.sh"
    fi
  fi

  # .codex/hooks/load-project-rules.sh
  if [ "$runtime" = "codex" ] || [ "$runtime" = "both" ]; then
    if [ -f ".codex/hooks/load-project-rules.sh" ]; then
      warn ".codex/hooks/load-project-rules.sh already exists, skipping"
    else
      cp "$TEMPLATES_DIR/dot-codex/hooks/load-project-rules.sh" ".codex/hooks/load-project-rules.sh"
      chmod +x ".codex/hooks/load-project-rules.sh"
      ok "Created .codex/hooks/load-project-rules.sh"
    fi
  fi

  # .codex/hooks/stop-reminder.py
  if [ "$runtime" = "codex" ] || [ "$runtime" = "both" ]; then
    if [ -f ".codex/hooks/stop-reminder.py" ]; then
      warn ".codex/hooks/stop-reminder.py already exists, skipping"
    else
      cp "$TEMPLATES_DIR/dot-codex/hooks/stop-reminder.py" ".codex/hooks/stop-reminder.py"
      chmod +x ".codex/hooks/stop-reminder.py"
      ok "Created .codex/hooks/stop-reminder.py"
    fi
  fi

  # .claude/rules/
  local rules=("memory-echo.md" "logs-writing.md" "information-lookup.md")
  for rule in "${rules[@]}"; do
    if [ -f ".claude/rules/$rule" ]; then
      warn ".claude/rules/$rule already exists, skipping"
    else
      cp "$TEMPLATES_DIR/dot-claude/rules/$rule" ".claude/rules/$rule"
      sedi "s|__HOME__|$HOME|g" ".claude/rules/$rule"
      sedi "s|__DOC_DIR__|$doc_dir|g" ".claude/rules/$rule"
      ok "Created .claude/rules/$rule"
    fi
  done

  # doc-dir files
  if [ -f "$doc_dir/00_AGENT_RULES.md" ]; then
    warn "$doc_dir/00_AGENT_RULES.md already exists, skipping"
  else
    cp "$TEMPLATES_DIR/doc-dir/00_AGENT_RULES.md" "$doc_dir/00_AGENT_RULES.md"
    sedi "s|__PROJECT_NAME__|$project_name|g" "$doc_dir/00_AGENT_RULES.md"
    ok "Created $doc_dir/00_AGENT_RULES.md"
  fi

  if [ -f "$doc_dir/01_PROJECT_OVERVIEW.md" ]; then
    warn "$doc_dir/01_PROJECT_OVERVIEW.md already exists, skipping"
  else
    cp "$TEMPLATES_DIR/doc-dir/01_PROJECT_OVERVIEW.md" "$doc_dir/01_PROJECT_OVERVIEW.md"
    sedi "s|__PROJECT_NAME__|$project_name|g" "$doc_dir/01_PROJECT_OVERVIEW.md"
    sedi "s|__TECH_STACK__|$tech_stack|g" "$doc_dir/01_PROJECT_OVERVIEW.md"
    ok "Created $doc_dir/01_PROJECT_OVERVIEW.md"
  fi

  # --- Register in project-registry ---

  local project_path
  project_path="$(pwd)"
  local memory_path="$CLAUDE_DIR/projects/-$(echo "$project_path" | tr '/' '-')/memory"

  if [ -f "$REGISTRY" ]; then
    if grep -q "$project_path" "$REGISTRY" 2>/dev/null; then
      warn "Project already registered in project-registry.md"
    else
      echo "| $project_name | $tech_stack | $project_path | $memory_path | active |" >> "$REGISTRY"
      ok "Registered in project-registry.md"
    fi
  fi

  # Register in project-registry.json (Phase 6: attention weights)
  if [ -f "$REGISTRY_JSON" ]; then
    python3 -c "
import json, sys, os
path = '$REGISTRY_JSON'
with open(path) as f:
    data = json.load(f)

# Check if project already registered
proj_path = '$project_path'
for p in data.get('projects', []):
    if p.get('path', '').rstrip('/') == proj_path.rstrip('/'):
        print('already registered')
        sys.exit(0)
    if p.get('name', '') == '$project_name':
        print('already registered')
        sys.exit(0)

# Parse tech_stack into domain tokens
tech = '$tech_stack'
domains = [t.strip().lower().replace('(', '').replace(')', '')
           for t in tech.replace('+', ',').replace('/', ',').split(',')
           if t.strip()]

# Add new project
data.setdefault('projects', []).append({
    'name': '$project_name',
    'tech_stack': tech,
    'path': proj_path,
    'memory_path': '$memory_path',
    'status': 'active',
    'domains': domains,
    'problems': [],
    'user_role': '',
    'pain_points': [],
    'activity': 1.0,
    'attention_weight': 1.0,
    'search_hits': 0,
    'last_active': None
})

# Update domain_index
di = data.setdefault('domain_index', {})
for d in domains:
    if d not in di:
        di[d] = []
    if '$project_name' not in di[d]:
        di[d].append('$project_name')

with open(path, 'w') as f:
    json.dump(data, f, indent=2, ensure_ascii=False)
    f.write('\n')
print('registered')
" 2>/dev/null
    local reg_result=$?
    if [ $reg_result -eq 0 ]; then
      ok "Registered in project-registry.json"
    fi
  else
    # Create initial JSON if missing
    python3 -c "
import json
tech = '$tech_stack'
domains = [t.strip().lower().replace('(', '').replace(')', '')
           for t in tech.replace('+', ',').replace('/', ',').split(',')
           if t.strip()]
data = {
    'version': 1,
    'projects': [{
        'name': '$project_name',
        'tech_stack': tech,
        'path': '$project_path',
        'memory_path': '$memory_path',
        'status': 'active',
        'domains': domains,
        'problems': [],
        'user_role': '',
        'pain_points': [],
        'activity': 1.0,
        'attention_weight': 1.0,
        'search_hits': 0,
        'last_active': None
    }],
    'domain_index': {d: ['$project_name'] for d in domains}
}
with open('$REGISTRY_JSON', 'w') as f:
    json.dump(data, f, indent=2, ensure_ascii=False)
    f.write('\n')
" 2>/dev/null
    ok "Created and registered in project-registry.json"
  fi

  # --- Done ---

  echo ""
  echo -e "${GREEN}========================================${NC}"
  echo -e "${GREEN}  Project initialized successfully!${NC}"
  echo -e "${GREEN}========================================${NC}"
  echo ""
  echo "Created:"
  if [ "$runtime" = "claude" ] || [ "$runtime" = "both" ]; then
    echo "  CLAUDE.md"
    echo "  .claude/settings.json"
    echo "  .claude/hooks/load-project-rules.sh"
  fi
  if [ "$runtime" = "codex" ] || [ "$runtime" = "both" ]; then
    echo "  AGENTS.md"
    echo "  .codex/hooks.json"
    echo "  .codex/hooks/{load-project-rules.sh,stop-reminder.py}"
  fi
  echo "  .claude/rules/{memory-echo,logs-writing,information-lookup}.md"
  echo "  $doc_dir/{00_AGENT_RULES,01_PROJECT_OVERVIEW}.md"
  echo "  $doc_dir/logs/"
  echo ""
  if [ "$runtime" = "both" ]; then
    echo "Next: Open this project with Claude Code or Codex to start using RadioHeader."
  elif [ "$runtime" = "claude" ]; then
    echo "Next: Open this project with Claude Code to start using RadioHeader."
  else
    echo "Next: Open this project with Codex to start using RadioHeader."
  fi

  if ! radiomind_available; then
    print_radiomind_suggestion
  fi
  echo ""
}

# ============================================================
# search
# ============================================================

cmd_search() {
  local field=""
  local pattern=""
  local use_fts="auto"  # auto | yes | no
  local use_attention="no"  # attention disabled by default (applied at consolidation, not search)

  # Parse flags
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --field=*) field="${1#--field=}"; shift ;;
      --field)   field="$2"; shift 2 ;;
      --fts)     use_fts="yes"; shift ;;
      --no-fts)  use_fts="no"; shift ;;
      --no-expand) use_fts="yes"; shift ;;  # implies FTS
      --attention) use_attention="yes"; shift ;;
      --no-attention) use_attention="no"; shift ;;
      --help|-h)
        cat <<EOF

${BOLD}radioheader search${NC} — Search RadioHeader (local + community)

${BOLD}USAGE${NC}
  radioheader search "keyword"
  radioheader search --field=tags "keyword"

${BOLD}OPTIONS${NC}
  --field=<field>   Limit search to a specific field:
                    tags, domain, id, symptom, fix, context, cause
  --fts             Force FTS5 search (BM25 ranking + synonym expansion)
  --no-fts          Force grep search (bypass FTS5 index)
  --no-expand       Disable synonym expansion (FTS5 only)
  --attention       Enable attention-weighted ranking (debug/experimental)
  --no-attention    Explicitly disable attention (default)

${BOLD}FTS5 SEARCH${NC}
  When search.db exists, FTS5 is used automatically:
  - BM25 ranking (relevance-based sorting)
  - Synonym expansion (白屏 → blank screen, white screen, empty screen)
  - Field-weighted scoring (tags/symptom weighted higher)
  Build index: radioheader index [--rebuild]

${BOLD}EXAMPLES${NC}
  radioheader search "白屏"                    # auto-expands Chinese↔English
  radioheader search --field=tags "NavigationStack"
  radioheader search --field=symptom "crash"
  radioheader search --no-fts "exact pattern"  # grep fallback

EOF
        return 0
        ;;
      *) pattern="$1"; shift ;;
    esac
  done

  if [ -z "$pattern" ]; then
    err "Usage: radioheader search \"keyword\""
    err "Use | to separate multiple keywords: radioheader search \"keyword1|keyword2\""
    return 1
  fi

  # --- RadioMind enhanced search (auto-upgrade when available) ---
  if radiomind_available && [ "$use_fts" != "no" ]; then
    local rm_args=("rh-search" "$pattern")
    if [ -n "$field" ]; then
      rm_args+=(--field "$field")
    fi
    if radiomind "${rm_args[@]}" 2>/dev/null; then
      return 0
    fi
    warn "RadioMind search failed, falling back to native search..."
  fi

  # --- FTS5 search path ---
  local fts_db="$RADIOHEADER_DIR/search.db"
  local fts_script
  fts_script="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/fts-search.py"

  # Determine if FTS5 should be used
  local do_fts=0
  if [ "$use_fts" = "yes" ]; then
    do_fts=1
  elif [ "$use_fts" = "auto" ] && [ -f "$fts_db" ] && [ -f "$fts_script" ]; then
    do_fts=1
  fi

  if [ "$do_fts" -eq 1 ]; then
    if [ ! -f "$fts_db" ]; then
      warn "FTS5 index not found. Run 'radioheader index' to build it."
      info "Falling back to grep search..."
    elif [ ! -f "$fts_script" ]; then
      warn "fts-search.py not found."
      info "Falling back to grep search..."
    else
      # Run FTS5 search
      local fts_args=("$fts_script" "$pattern" --json)
      if [ -n "$field" ]; then
        fts_args+=(--field "$field")
      fi
      if [ "$use_attention" = "yes" ]; then
        fts_args+=(--attention)
      fi

      local fts_output
      fts_output=$("$RH_PY" "${fts_args[@]}" 2>/dev/null)
      if [ $? -ne 0 ] || [ -z "$fts_output" ]; then
        warn "FTS5 search failed, falling back to grep..."
      else
        # Parse and display FTS5 results
        local fts_count
        fts_count=$(echo "$fts_output" | "$RH_PY" -c "import json,sys; d=json.load(sys.stdin); print(d['count'])" 2>/dev/null)
        local fts_expanded
        fts_expanded=$(echo "$fts_output" | "$RH_PY" -c "import json,sys; d=json.load(sys.stdin); print(', '.join(d['expanded']))" 2>/dev/null)

        if [ "${fts_count:-0}" -eq 0 ]; then
          local search_desc="$pattern"
          if [ -n "$field" ]; then
            search_desc="$pattern (field: $field)"
          fi
          warn "No matches found for: $search_desc"
          echo -e "${DIM}Tip: Try broader keywords or synonyms.${NC}"
          return 0
        fi

        # Header
        local display_pattern="$pattern"
        if [ -n "$field" ]; then
          display_pattern="$pattern ${DIM}(field: $field)${NC}"
        fi
        echo -e "${DIM}Searching (FTS5): ${NC}${BOLD}$display_pattern${NC}"
        if [ -n "$fts_expanded" ]; then
          echo -e "${DIM}Synonyms: +${fts_expanded}${NC}"
        fi
        # Determine ranking mode display
        local rank_mode="BM25"
        if [ "$use_attention" = "yes" ]; then
          local has_attention
          has_attention=$(echo "$fts_output" | "$RH_PY" -c "import json,sys; d=json.load(sys.stdin); print('yes' if d.get('attention') else 'no')" 2>/dev/null)
          if [ "$has_attention" = "yes" ]; then
            rank_mode="BM25 + Attention"
          fi
        fi
        echo -e "${GREEN}Found $fts_count result(s) (${rank_mode} ranked):${NC}"

        # Show project attention scores if available
        if [ "$use_attention" = "yes" ]; then
          local attn_scores
          attn_scores=$(echo "$fts_output" | "$RH_PY" -c "
import json,sys
d=json.load(sys.stdin)
ps=d.get('project_scores',{})
if ps:
    parts=[f'{k}={v}' for k,v in ps.items()]
    print(', '.join(parts))
" 2>/dev/null)
          if [ -n "$attn_scores" ]; then
            echo -e "${DIM}  Project attention: ${attn_scores}${NC}"
          fi
        fi
        echo ""

        # Display results grouped by source
        echo "$fts_output" | "$RH_PY" -c "
import json, sys
d = json.load(sys.stdin)
by_source = {'shortwave': [], 'community': [], 'topic': []}
for r in d['results']:
    src = r['source']
    if src in by_source:
        by_source[src].append(r)

labels = {
    'shortwave': '📡 Shortwave (本地精炼)',
    'community': '🌐 Community (社区共享)',
    'topic': '📂 Topics (详细)',
}
for src in ['shortwave', 'community', 'topic']:
    entries = by_source[src]
    if not entries:
        continue
    print(f'  \033[1m{labels[src]}:\033[0m')
    for r in entries:
        title = r['title'] or r['id']
        # Truncate long titles
        if len(title) > 70:
            title = title[:67] + '...'
        # Attention weight indicator
        attn = ''
        aw = r.get('attention_weight')
        if aw and aw != 1.0:
            attn = f' \033[33m[attn:{aw:.1f}]\033[0m'
        # Project info
        proj = ''
        if r.get('projects'):
            proj = f' \033[2m({r[\"projects\"]})\033[0m'
        print(f'    \033[0;36m{r[\"id\"]}\033[0m: {title}{attn}{proj}')
        if r.get('symptom'):
            s = r['symptom']
            if len(s) > 80:
                s = s[:77] + '...'
            print(f'      \033[2msymptom: {s}\033[0m')
    print()
" 2>/dev/null
        return 0
      fi
    fi
  fi

  local total_matches=0

  # Build grep pattern: if field specified, anchor to field prefix
  local grep_pattern="$pattern"
  if [ -n "$field" ]; then
    # Normalize field aliases
    local field_regex="$field"
    case "$field" in
      symptom|symptoms) field_regex="symptoms?" ;;
    esac
    # Match lines that start with the field name (case-insensitive)
    grep_pattern="^${field_regex}:.*($pattern)"
  fi

  # --- Shortwave results (refined, shown first) ---
  local sw_results=""
  local sw_count=0
  if [ -d "$SHORTWAVE_DIR" ]; then
    local sw_file_count
    sw_file_count=$(find "$SHORTWAVE_DIR" -name "*.md" -type f 2>/dev/null | wc -l | tr -d ' ')
    if [ "$sw_file_count" -gt 0 ]; then
      sw_results=$(grep -n -i -E "$grep_pattern" "$SHORTWAVE_DIR"/*.md 2>/dev/null || true)
      if [ -n "$sw_results" ]; then
        sw_count=$(echo "$sw_results" | wc -l | tr -d ' ')
      fi
    fi
  fi

  # --- Community results (if enabled) ---
  local community_results=""
  local community_count=0
  if community_enabled && [ -d "$COMMUNITY_POOL" ]; then
    local pool_file_count
    pool_file_count=$(find "$COMMUNITY_POOL" -name "*.md" -type f 2>/dev/null | wc -l | tr -d ' ')
    if [ "$pool_file_count" -gt 0 ]; then
      community_results=$(grep -n -i -E "$grep_pattern" "$COMMUNITY_POOL"/*.md 2>/dev/null || true)
      if [ -n "$community_results" ]; then
        community_count=$(echo "$community_results" | wc -l | tr -d ' ')
      fi
    fi
  fi

  # --- Topics results (detailed) ---
  local topic_results=""
  local topic_count=0
  if [ -d "$TOPICS_DIR" ]; then
    local topic_file_count
    topic_file_count=$(find "$TOPICS_DIR" -name "*.md" -type f 2>/dev/null | wc -l | tr -d ' ')
    if [ "$topic_file_count" -gt 0 ]; then
      topic_results=$(grep -n -i -E "$grep_pattern" "$TOPICS_DIR"/*.md 2>/dev/null || true)
      if [ -n "$topic_results" ]; then
        topic_count=$(echo "$topic_results" | wc -l | tr -d ' ')
      fi
    fi
  fi

  total_matches=$((sw_count + community_count + topic_count))

  if [ "$total_matches" -eq 0 ]; then
    local search_desc="$pattern"
    if [ -n "$field" ]; then
      search_desc="$pattern (field: $field)"
    fi
    warn "No matches found for: $search_desc"
    echo -e "${DIM}Tip: Try broader keywords or synonyms. Use --field to filter by specific fields.${NC}"
    return 0
  fi

  local display_pattern="$pattern"
  if [ -n "$field" ]; then
    display_pattern="$pattern ${DIM}(field: $field)${NC}"
  fi
  echo -e "${DIM}Searching for: ${NC}${BOLD}$display_pattern${NC}"
  echo -e "${GREEN}Found $total_matches match(es):${NC}"
  echo ""

  # Display shortwave results first (local = highest priority)
  if [ -n "$sw_results" ]; then
    echo -e "  ${BOLD}📡 Shortwave (本地精炼):${NC}"
    echo "$sw_results" | while IFS= read -r line; do
      local file_part="${line%%:*}"
      local rest="${line#*:}"
      local linenum="${rest%%:*}"
      local content="${rest#*:}"
      local bname
      bname=$(basename "$file_part")
      echo -e "    ${CYAN}$bname${NC}:${YELLOW}$linenum${NC}: $content"
    done
    echo ""
  fi

  # Display community results (second priority, with score labels)
  if [ -n "$community_results" ]; then
    # Load scores if available
    local scores_file="$COMMUNITY_DIR/scores.json"
    echo -e "  ${BOLD}🌐 Community (社区共享):${NC}"
    echo "$community_results" | while IFS= read -r line; do
      local file_part="${line%%:*}"
      local rest="${line#*:}"
      local linenum="${rest%%:*}"
      local content="${rest#*:}"
      local bname
      bname=$(basename "$file_part")
      local sw_id="${bname%.md}"
      # Try to get score from scores.json
      local score_label=""
      if [ -f "$scores_file" ]; then
        local score
        score=$(grep "\"$sw_id\"" "$scores_file" 2>/dev/null | grep -o '"score"[[:space:]]*:[[:space:]]*[0-9.]*' | head -1 | sed 's/.*://' | xargs)
        local usage
        usage=$(grep "\"$sw_id\"" "$scores_file" 2>/dev/null | grep -o '"usage"[[:space:]]*:[[:space:]]*[0-9]*' | head -1 | sed 's/.*://' | xargs)
        if [ -n "$score" ]; then
          # High score + high usage = verified
          if [ "${usage:-0}" -ge 10 ] 2>/dev/null && [ "$(echo "$score >= 8" | bc 2>/dev/null)" = "1" ] 2>/dev/null; then
            score_label=" ${GREEN}✅ verified${NC} (score:$score, usage:$usage)"
          elif [ -n "$usage" ]; then
            score_label=" ${DIM}(score:$score, usage:$usage)${NC}"
          else
            score_label=" ${DIM}(score:$score)${NC}"
          fi
        fi
      fi
      echo -e "    ${CYAN}$bname${NC}:${YELLOW}$linenum${NC}: $content$score_label"
    done
    echo ""
  fi

  # Display topics results
  if [ -n "$topic_results" ]; then
    echo -e "  ${BOLD}📂 Topics (详细):${NC}"
    echo "$topic_results" | while IFS= read -r line; do
      local file_part="${line%%:*}"
      local rest="${line#*:}"
      local linenum="${rest%%:*}"
      local content="${rest#*:}"
      local bname
      bname=$(basename "$file_part")
      echo -e "    ${CYAN}$bname${NC}:${YELLOW}$linenum${NC}: $content"
    done
    echo ""
  fi
}

# ============================================================
# index
# ============================================================

cmd_index() {
  local rebuild=""
  if [ "${1:-}" = "--rebuild" ]; then
    rebuild="--rebuild"
  fi

  local index_script
  index_script="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/fts-index.py"

  if [ ! -f "$index_script" ]; then
    err "fts-index.py not found at: $index_script"
    return 1
  fi

  if [ -z "$RH_PY" ] || ! command -v "$RH_PY" >/dev/null 2>&1; then
    err "Python 3.7+ is required for FTS5 indexing. Set RH_PY_OVERRIDE to a working interpreter."
    return 1
  fi

  info "Building FTS5 search index..."
  "$RH_PY" "$index_script" --db "$RADIOHEADER_DIR/search.db" --radioheader-dir "$RADIOHEADER_DIR" $rebuild
  ok "Search index ready. Use 'radioheader search' to search with BM25 ranking + synonym expansion."
}

# ============================================================
# status
# ============================================================

cmd_status() {
  echo ""
  echo -e "${BOLD}RadioHeader Status${NC}"
  echo ""

  # --- Installation check ---
  if [ ! -d "$RADIOHEADER_DIR" ]; then
    err "RadioHeader is not installed."
    return 1
  fi

  ok "Installed at $RADIOHEADER_DIR"

  # --- Topic files ---
  local topic_count=0
  local entry_count=0
  local latest_file=""
  local latest_time=0

  if [ -d "$TOPICS_DIR" ]; then
    topic_count=$(find "$TOPICS_DIR" -name "*.md" -type f 2>/dev/null | wc -l | tr -d ' ')

    if [ "$topic_count" -gt 0 ]; then
      # Count entries (lines starting with "- [")
      entry_count=$(grep -r '^\- \[' "$TOPICS_DIR"/*.md 2>/dev/null | wc -l | tr -d ' ')

      # Find most recently modified file
      if [[ "$OSTYPE" == darwin* ]]; then
        latest_file=$(find "$TOPICS_DIR" -name "*.md" -type f -exec stat -f '%m %N' {} + 2>/dev/null | sort -rn | head -1 | cut -d' ' -f2-)
      else
        latest_file=$(find "$TOPICS_DIR" -name "*.md" -type f -printf '%T@ %p\n' 2>/dev/null | sort -rn | head -1 | cut -d' ' -f2-)
      fi
    fi
  fi

  echo -e "  Topic files:  ${BOLD}$topic_count${NC}"
  echo -e "  Entries:      ${BOLD}$entry_count${NC}"
  if [ -n "$latest_file" ]; then
    echo -e "  Latest:       $(basename "$latest_file")"
  fi

  # --- Shortwave files ---
  local sw_count=0
  if [ -d "$SHORTWAVE_DIR" ]; then
    sw_count=$(find "$SHORTWAVE_DIR" -name "*.md" -type f 2>/dev/null | wc -l | tr -d ' ')
  fi
  echo -e "  Shortwave:    ${BOLD}$sw_count${NC} entries"

  # --- Registered projects ---
  local project_count=0
  if [ -f "$REGISTRY_JSON" ]; then
    project_count=$(python3 - "$REGISTRY_JSON" <<'PY'
import json
import sys

with open(sys.argv[1]) as f:
    data = json.load(f)

print(len(data.get("projects", [])))
PY
)
  elif [ -f "$REGISTRY" ]; then
    project_count=$(grep -c '^|' "$REGISTRY" 2>/dev/null || echo "0")
    # Subtract header rows (2: header + separator)
    project_count=$((project_count > 2 ? project_count - 2 : 0))
  fi
  echo -e "  Projects:     ${BOLD}$project_count${NC} registered"

  # --- Community status ---
  echo ""
  echo -e "${BOLD}Community${NC}"
  if community_enabled; then
    echo -e "  Status:     ${GREEN}ON${NC}"
    if [ -d "$COMMUNITY_DIR/.git" ]; then
      local pool_count=0
      if [ -d "$COMMUNITY_POOL" ]; then
        pool_count=$(find "$COMMUNITY_POOL" -name "*.md" -type f 2>/dev/null | wc -l | tr -d ' ')
      fi
      echo -e "  Pool:       ${BOLD}$pool_count${NC} entries"
    else
      echo -e "  Pool:       ${YELLOW}not synced${NC} (run 'radioheader sync')"
    fi
  else
    echo -e "  Status:     ${DIM}OFF${NC} (enable with 'radioheader community on')"
  fi

  # --- Runtime check ---
  echo ""
  echo -e "${BOLD}Runtimes${NC}"

  local shared_hooks=(
    "check-project-architecture.sh"
    "radioheader-loader.sh"
    "radioheader-error-capture.sh"
  )
  local claude_hooks=(
    "radioheader-memory-sync.sh"
    "radioheader-stop-echo.sh"
  )
  local codex_hooks=(
    "radioheader-codex-userprompt.py"
    "radioheader-stop-codex.py"
  )
  local claude_runtime_enabled=false
  local codex_runtime_enabled=false

  if [ -f "$CLAUDE_DIR/CLAUDE.md" ] && grep -q "RadioHeader START" "$CLAUDE_DIR/CLAUDE.md" 2>/dev/null; then
    claude_runtime_enabled=true
  elif [ -f "$CLAUDE_DIR/settings.json" ] && grep -q "radioheader-loader.sh" "$CLAUDE_DIR/settings.json" 2>/dev/null; then
    claude_runtime_enabled=true
  fi

  if [ -f "$CODEX_AGENTS" ] && grep -q "RadioHeader START" "$CODEX_AGENTS" 2>/dev/null; then
    codex_runtime_enabled=true
  elif [ -f "$CODEX_HOOKS_JSON" ] && grep -q "radioheader-stop-codex.py" "$CODEX_HOOKS_JSON" 2>/dev/null; then
    codex_runtime_enabled=true
  fi

  for hook in "${shared_hooks[@]}"; do
    if [ -x "$CLAUDE_DIR/hooks/$hook" ]; then
      echo -e "  ${GREEN}✓${NC} shared hook: $hook"
    else
      echo -e "  ${RED}✗${NC} shared hook: $hook"
    fi
  done

  if [ "$claude_runtime_enabled" = true ]; then
    for hook in "${claude_hooks[@]}"; do
      if [ -x "$CLAUDE_DIR/hooks/$hook" ]; then
        echo -e "  ${GREEN}✓${NC} Claude hook: $hook"
      else
        echo -e "  ${RED}✗${NC} Claude hook: $hook"
      fi
    done
  else
    echo -e "  ${DIM}-${NC} Claude runtime not enabled"
  fi

  if [ "$codex_runtime_enabled" = true ]; then
    for hook in "${codex_hooks[@]}"; do
      if [ -x "$CLAUDE_DIR/hooks/$hook" ]; then
        echo -e "  ${GREEN}✓${NC} Codex hook: $hook"
      else
        echo -e "  ${RED}✗${NC} Codex hook: $hook"
      fi
    done
  else
    echo -e "  ${DIM}-${NC} Codex runtime not enabled"
  fi

  # --- CLAUDE.md check ---
  echo ""
  echo -e "${BOLD}Configuration${NC}"

  if [ "$claude_runtime_enabled" = true ] && [ -f "$CLAUDE_DIR/CLAUDE.md" ] && grep -q "RadioHeader START" "$CLAUDE_DIR/CLAUDE.md" 2>/dev/null; then
    echo -e "  ${GREEN}✓${NC} Claude runtime enabled"
    echo -e "  ${GREEN}✓${NC} CLAUDE.md has RadioHeader rules"
  elif [ "$claude_runtime_enabled" = true ]; then
    echo -e "  ${YELLOW}!${NC} Claude runtime enabled but CLAUDE.md missing RadioHeader rules"
  else
    echo -e "  ${DIM}-${NC} Claude runtime not enabled"
  fi

  if [ "$claude_runtime_enabled" = true ] && [ -f "$CLAUDE_DIR/settings.json" ]; then
    echo -e "  ${GREEN}✓${NC} settings.json exists"
  elif [ "$claude_runtime_enabled" = true ]; then
    echo -e "  ${YELLOW}!${NC} settings.json missing"
  else
    :
  fi

  if [ "$codex_runtime_enabled" = true ] && [ -f "$CODEX_AGENTS" ] && grep -q "RadioHeader START" "$CODEX_AGENTS" 2>/dev/null; then
    echo -e "  ${GREEN}✓${NC} Codex runtime enabled"
    echo -e "  ${GREEN}✓${NC} ~/.codex/AGENTS.md has RadioHeader rules"
  elif [ "$codex_runtime_enabled" = true ]; then
    echo -e "  ${YELLOW}!${NC} Codex runtime enabled but ~/.codex/AGENTS.md missing RadioHeader rules"
  else
    echo -e "  ${DIM}-${NC} Codex runtime not enabled"
  fi

  if [ "$codex_runtime_enabled" = true ] && [ -f "$CODEX_HOOKS_JSON" ]; then
    echo -e "  ${GREEN}✓${NC} ~/.codex/hooks.json exists"
  elif [ "$codex_runtime_enabled" = true ]; then
    echo -e "  ${YELLOW}!${NC} ~/.codex/hooks.json missing"
  else
    :
  fi

  if [ -d "$TEMPLATES_DIR" ]; then
    echo -e "  ${GREEN}✓${NC} Project templates installed"
  else
    echo -e "  ${YELLOW}~${NC} Project templates not installed (CLI init won't work)"
  fi

  echo -e "  Project runtime: $(project_runtime_summary)"

  echo ""
  echo -e "${BOLD}RadioMind${NC}"
  if radiomind_available; then
    local rm_version
    rm_version=$(radiomind --version 2>/dev/null || echo "unknown")
    echo -e "  Status:     ${GREEN}ON${NC} ($rm_version)"
  else
    echo -e "  Status:     ${DIM}NOT INSTALLED${NC} (optional — pip install radiomind)"
  fi

  echo ""
}

# ============================================================
# doctor
# ============================================================

cmd_doctor() {
  echo ""
  echo -e "${BOLD}RadioHeader Doctor${NC}"
  echo ""

  local issues=0
  local claude_runtime_enabled=false
  local codex_runtime_enabled=false
  local shared_hooks=(
    "check-project-architecture.sh"
    "radioheader-loader.sh"
    "radioheader-error-capture.sh"
  )
  local claude_hooks=(
    "radioheader-memory-sync.sh"
    "radioheader-stop-echo.sh"
  )
  local codex_hooks=(
    "radioheader-codex-userprompt.py"
    "radioheader-stop-codex.py"
  )

  # --- Global installation ---
  echo -e "${BOLD}Global Installation${NC}"

  if [ ! -d "$RADIOHEADER_DIR" ]; then
    echo -e "  ${RED}✗${NC} RadioHeader directory missing"
    err "RadioHeader is not installed. Run install.sh first."
    return 1
  fi
  echo -e "  ${GREEN}✓${NC} RadioHeader directory exists"

  # CLI reachable on PATH — install.sh may fall back to ~/bin, which is not in
  # the default PATH on macOS zsh; then every shell reports "command not found"
  # even though the CLI is installed and healthy.
  local cli_bin=""
  local cli_candidate
  for cli_candidate in /usr/local/bin/radioheader "$HOME/bin/radioheader"; do
    if [ -x "$cli_candidate" ]; then cli_bin="$cli_candidate"; break; fi
  done
  if command -v radioheader >/dev/null 2>&1; then
    echo -e "  ${GREEN}✓${NC} CLI on PATH ($(command -v radioheader))"
  elif [ -n "$cli_bin" ]; then
    local rc_hint
    case "${SHELL:-}" in
      */zsh)  rc_hint="$HOME/.zshrc" ;;
      */bash) if [ "$(uname)" = "Darwin" ]; then rc_hint="$HOME/.bash_profile"; else rc_hint="$HOME/.bashrc"; fi ;;
      *)      rc_hint="$HOME/.profile" ;;
    esac
    echo -e "  ${RED}✗${NC} CLI installed at $cli_bin but $(dirname "$cli_bin") is not in PATH"
    echo -e "    Fix: echo 'export PATH=\"\$HOME/bin:\$PATH\"' >> $rc_hint  (then restart your shell)"
    issues=$((issues + 1))
  else
    echo -e "  ${RED}✗${NC} CLI binary not found in /usr/local/bin or ~/bin — re-run install.sh"
    issues=$((issues + 1))
  fi

  if [ -f "$CLAUDE_DIR/CLAUDE.md" ] && grep -q "RadioHeader START" "$CLAUDE_DIR/CLAUDE.md" 2>/dev/null; then
    claude_runtime_enabled=true
  elif [ -f "$CLAUDE_DIR/settings.json" ] && grep -q "radioheader-loader.sh" "$CLAUDE_DIR/settings.json" 2>/dev/null; then
    claude_runtime_enabled=true
  fi

  if [ -f "$CODEX_AGENTS" ] && grep -q "RadioHeader START" "$CODEX_AGENTS" 2>/dev/null; then
    codex_runtime_enabled=true
  elif [ -f "$CODEX_HOOKS_JSON" ] && grep -q "radioheader-stop-codex.py" "$CODEX_HOOKS_JSON" 2>/dev/null; then
    codex_runtime_enabled=true
  fi

  # Shared hooks
  for hook in "${shared_hooks[@]}"; do
    if [ ! -f "$CLAUDE_DIR/hooks/$hook" ]; then
      echo -e "  ${RED}✗${NC} Shared hook missing: $hook"
      issues=$((issues + 1))
    elif [ ! -x "$CLAUDE_DIR/hooks/$hook" ]; then
      echo -e "  ${YELLOW}!${NC} Shared hook not executable: $hook"
      issues=$((issues + 1))
    else
      echo -e "  ${GREEN}✓${NC} Shared hook: $hook"
    fi
  done

  if [ "$claude_runtime_enabled" = true ]; then
    for hook in "${claude_hooks[@]}"; do
      if [ ! -f "$CLAUDE_DIR/hooks/$hook" ]; then
        echo -e "  ${RED}✗${NC} Claude hook missing: $hook"
        issues=$((issues + 1))
      elif [ ! -x "$CLAUDE_DIR/hooks/$hook" ]; then
        echo -e "  ${YELLOW}!${NC} Claude hook not executable: $hook"
        issues=$((issues + 1))
      else
        echo -e "  ${GREEN}✓${NC} Claude hook: $hook"
      fi
    done
  else
    echo -e "  ${DIM}-${NC} Claude runtime not enabled"
  fi

  if [ "$codex_runtime_enabled" = true ]; then
    for hook in "${codex_hooks[@]}"; do
      if [ ! -f "$CLAUDE_DIR/hooks/$hook" ]; then
        echo -e "  ${RED}✗${NC} Codex hook missing: $hook"
        issues=$((issues + 1))
      elif [ ! -x "$CLAUDE_DIR/hooks/$hook" ]; then
        echo -e "  ${YELLOW}!${NC} Codex hook not executable: $hook"
        issues=$((issues + 1))
      else
        echo -e "  ${GREEN}✓${NC} Codex hook: $hook"
      fi
    done
  else
    echo -e "  ${DIM}-${NC} Codex runtime not enabled"
  fi

  # CLAUDE.md
  if [ "$claude_runtime_enabled" = true ] && [ -f "$CLAUDE_DIR/CLAUDE.md" ]; then
    if grep -q "RadioHeader START" "$CLAUDE_DIR/CLAUDE.md" 2>/dev/null; then
      echo -e "  ${GREEN}✓${NC} CLAUDE.md has RadioHeader markers"
    else
      echo -e "  ${RED}✗${NC} CLAUDE.md missing RadioHeader rules section"
      issues=$((issues + 1))
    fi
  elif [ "$claude_runtime_enabled" = true ]; then
    echo -e "  ${RED}✗${NC} CLAUDE.md not found"
    issues=$((issues + 1))
  else
    echo -e "  ${DIM}-${NC} Claude runtime not enabled"
  fi

  # settings.json
  if [ "$claude_runtime_enabled" = true ] && [ -f "$CLAUDE_DIR/settings.json" ]; then
    local missing_hooks=0
    local expected_claude_refs=("${shared_hooks[@]}" "${claude_hooks[@]}")
    for hook in "${expected_claude_refs[@]}"; do
      if ! grep -q "$hook" "$CLAUDE_DIR/settings.json" 2>/dev/null; then
        echo -e "  ${YELLOW}!${NC} settings.json missing reference to $hook"
        missing_hooks=$((missing_hooks + 1))
        issues=$((issues + 1))
      fi
    done
    if [ "$missing_hooks" -eq 0 ]; then
      echo -e "  ${GREEN}✓${NC} settings.json has all hook references"
    fi
  elif [ "$claude_runtime_enabled" = true ]; then
    echo -e "  ${RED}✗${NC} settings.json not found"
    issues=$((issues + 1))
  else
    :
  fi

  if [ "$codex_runtime_enabled" = true ] && [ -f "$CODEX_AGENTS" ]; then
    if grep -q "RadioHeader START" "$CODEX_AGENTS" 2>/dev/null; then
      echo -e "  ${GREEN}✓${NC} ~/.codex/AGENTS.md has RadioHeader markers"
    else
      echo -e "  ${YELLOW}!${NC} ~/.codex/AGENTS.md missing RadioHeader rules section"
      issues=$((issues + 1))
    fi
  elif [ "$codex_runtime_enabled" = true ]; then
    echo -e "  ${YELLOW}!${NC} ~/.codex/AGENTS.md not found"
    issues=$((issues + 1))
  else
    echo -e "  ${DIM}-${NC} Codex runtime not enabled"
  fi

  if [ "$codex_runtime_enabled" = true ] && [ -f "$CODEX_HOOKS_JSON" ]; then
    local codex_targets=(
      "check-project-architecture.sh"
      "radioheader-loader.sh"
      "radioheader-error-capture.sh"
      "radioheader-codex-userprompt.py"
      "radioheader-stop-codex.py"
    )
    local missing_codex_hooks=0
    for hook in "${codex_targets[@]}"; do
      if ! grep -q "$hook" "$CODEX_HOOKS_JSON" 2>/dev/null; then
        echo -e "  ${YELLOW}!${NC} ~/.codex/hooks.json missing reference to $hook"
        missing_codex_hooks=$((missing_codex_hooks + 1))
        issues=$((issues + 1))
      fi
    done
    if [ "$missing_codex_hooks" -eq 0 ]; then
      echo -e "  ${GREEN}✓${NC} ~/.codex/hooks.json has all RadioHeader references"
    fi
  elif [ "$codex_runtime_enabled" = true ]; then
    echo -e "  ${YELLOW}!${NC} ~/.codex/hooks.json not found"
    issues=$((issues + 1))
  else
    :
  fi

  # Templates
  if [ -d "$TEMPLATES_DIR" ]; then
    echo -e "  ${GREEN}✓${NC} Project templates installed"
  else
    echo -e "  ${YELLOW}!${NC} Project templates not installed (radioheader init won't work)"
    issues=$((issues + 1))
  fi

  # --- Topic files ---
  echo ""
  echo -e "${BOLD}Topic Files${NC}"

  if [ -d "$TOPICS_DIR" ]; then
    local topic_count
    topic_count=$(find "$TOPICS_DIR" -name "*.md" -type f 2>/dev/null | wc -l | tr -d ' ')
    echo -e "  ${GREEN}✓${NC} $topic_count topic file(s)"

    if [ "$topic_count" -gt 0 ]; then
      # Check for entries missing [source:] tags
      local untagged=0
      untagged=$(grep -r '^\- [^[[]' "$TOPICS_DIR"/*.md 2>/dev/null | wc -l | tr -d ' ')
      if [ "$untagged" -gt 0 ]; then
        echo -e "  ${YELLOW}!${NC} $untagged entries without [source:] tag"
        issues=$((issues + 1))
      else
        echo -e "  ${GREEN}✓${NC} All entries have [source:] tags"
      fi

      # Check for empty files
      local empty_files=0
      for f in "$TOPICS_DIR"/*.md; do
        if [ ! -s "$f" ]; then
          echo -e "  ${YELLOW}!${NC} Empty file: $(basename "$f")"
          empty_files=$((empty_files + 1))
          issues=$((issues + 1))
        fi
      done
      if [ "$empty_files" -eq 0 ]; then
        echo -e "  ${GREEN}✓${NC} No empty files"
      fi
    fi
  else
    echo -e "  ${YELLOW}!${NC} Topics directory not found"
    issues=$((issues + 1))
  fi

  # --- Shortwave files ---
  echo ""
  echo -e "${BOLD}Shortwave Files${NC}"

  if [ -d "$SHORTWAVE_DIR" ]; then
    local sw_count
    sw_count=$(find "$SHORTWAVE_DIR" -name "*.md" -type f 2>/dev/null | wc -l | tr -d ' ')
    echo -e "  ${GREEN}✓${NC} $sw_count shortwave file(s)"

    if [ "$sw_count" -gt 0 ]; then
      # Check for required YAML frontmatter fields: id, domain, tags
      local missing_meta=0
      for f in "$SHORTWAVE_DIR"/*.md; do
        [ -f "$f" ] || continue
        local bname
        bname=$(basename "$f")
        local has_id has_domain has_tags
        has_id=$(grep '^id:' "$f" 2>/dev/null | wc -l | tr -d ' ')
        has_domain=$(grep '^domain:' "$f" 2>/dev/null | wc -l | tr -d ' ')
        has_tags=$(grep '^tags:' "$f" 2>/dev/null | wc -l | tr -d ' ')
        if [ "$has_id" -eq 0 ] || [ "$has_domain" -eq 0 ] || [ "$has_tags" -eq 0 ]; then
          echo -e "  ${YELLOW}!${NC} Missing metadata in $bname (need: id, domain, tags)"
          missing_meta=$((missing_meta + 1))
          issues=$((issues + 1))
        fi
      done
      if [ "$missing_meta" -eq 0 ]; then
        echo -e "  ${GREEN}✓${NC} All shortwave files have required metadata"
      fi
    fi
  else
    echo -e "  ${YELLOW}!${NC} Shortwave directory not found (run install.sh to create)"
    issues=$((issues + 1))
  fi

  # --- INDEX.md consistency ---
  echo ""
  echo -e "${BOLD}INDEX.md Consistency${NC}"

  if [ -f "$INDEX" ]; then
    if [ -d "$TOPICS_DIR" ]; then
      local index_entries
      index_entries=$(grep -c '\.md' "$INDEX" 2>/dev/null || echo "0")
      local actual_files
      actual_files=$(find "$TOPICS_DIR" -name "*.md" -type f 2>/dev/null | wc -l | tr -d ' ')

      if [ "$index_entries" -eq 0 ] && [ "$actual_files" -gt 0 ]; then
        echo -e "  ${YELLOW}!${NC} INDEX.md has no topic entries but $actual_files topic files exist"
        issues=$((issues + 1))
      else
        echo -e "  ${GREEN}✓${NC} INDEX.md has $index_entries references, $actual_files actual files"
      fi

      # Check for files in topics/ not listed in INDEX.md
      local unlisted=0
      for f in "$TOPICS_DIR"/*.md; do
        [ -f "$f" ] || continue
        local bname
        bname=$(basename "$f")
        if ! grep -q "$bname" "$INDEX" 2>/dev/null; then
          echo -e "  ${YELLOW}!${NC} Topic not in INDEX: $bname"
          unlisted=$((unlisted + 1))
          issues=$((issues + 1))
        fi
      done
      if [ "$unlisted" -eq 0 ] && [ "$actual_files" -gt 0 ]; then
        echo -e "  ${GREEN}✓${NC} All topic files listed in INDEX.md"
      fi
    fi
  else
    echo -e "  ${RED}✗${NC} INDEX.md not found"
    issues=$((issues + 1))
  fi

  # --- Project Registry ---
  echo ""
  echo -e "${BOLD}Project Registry${NC}"

  if [ -f "$REGISTRY_JSON" ]; then
    local stale=0
    while IFS=$'\t' read -r path status; do
      [ -z "$path" ] && continue
      if [[ "$status" == "archived" ]] || [[ "$status" == "archive" ]]; then
        continue
      fi
      if [ ! -d "$path" ]; then
        echo -e "  ${YELLOW}!${NC} Stale project path: $path"
        stale=$((stale + 1))
        issues=$((issues + 1))
      fi
    done < <(
      python3 - "$REGISTRY_JSON" <<'PY'
import json
import os
import sys

with open(sys.argv[1]) as f:
    data = json.load(f)

for project in data.get("projects", []):
    path = os.path.expanduser((project.get("path") or "").strip())
    status = (project.get("status") or "active").strip().lower()
    if path:
        print(f"{path}\t{status}")
PY
    )

    if [ "$stale" -eq 0 ]; then
      echo -e "  ${GREEN}✓${NC} All registered project paths are valid"
    fi
  elif [ -f "$REGISTRY" ]; then
    local stale=0
    while IFS='|' read -r _ _ _ path _ status _; do
      path=$(echo "$path" | xargs) # trim whitespace
      status=$(echo "$status" | xargs) # trim whitespace
      # Remove surrounding backticks if present
      path="${path#\`}"
      path="${path%\`}"
      # Expand ~ to $HOME
      path="${path/#\~/$HOME}"
      # Skip archived/inactive projects
      if [[ "$status" == *"归档"* ]] || [[ "$status" == *"archive"* ]]; then
        continue
      fi
      if [ -n "$path" ] && [ "$path" != "Project Path" ] && [[ "$path" != -* ]] && [[ "$path" != *"add your"* ]] && [[ "$path" != *"项目"* ]]; then
        if [ ! -d "$path" ]; then
          echo -e "  ${YELLOW}!${NC} Stale project path: $path"
          stale=$((stale + 1))
          issues=$((issues + 1))
        fi
      fi
    done < "$REGISTRY"

    if [ "$stale" -eq 0 ]; then
      echo -e "  ${GREEN}✓${NC} All registered project paths are valid"
    fi
  else
    echo -e "  ${YELLOW}!${NC} project-registry.json / project-registry.md not found"
    issues=$((issues + 1))
  fi

  # --- Optional: web-extract skill ---
  echo ""
  echo -e "${BOLD}Optional: web-extract Skill${NC}"

  if [ -d "$CLAUDE_DIR/skills/web-extract" ]; then
    echo -e "  ${GREEN}✓${NC} web-extract skill directory exists"
    if [ -f "$CLAUDE_DIR/skills/web-extract/SKILL.md" ]; then
      echo -e "  ${GREEN}✓${NC} SKILL.md present"
    else
      echo -e "  ${YELLOW}!${NC} SKILL.md missing"
    fi
    if [ -f "$CLAUDE_DIR/skills/web-extract/scrapling_fetch.py" ]; then
      echo -e "  ${GREEN}✓${NC} scrapling_fetch.py present"
    else
      echo -e "  ${YELLOW}!${NC} scrapling_fetch.py missing"
    fi
    if [ -d "$CLAUDE_DIR/skills/web-extract/.venv" ]; then
      if "$CLAUDE_DIR/skills/web-extract/.venv/bin/python3" -c "import scrapling, html2text" 2>/dev/null; then
        echo -e "  ${GREEN}✓${NC} Python dependencies OK (scrapling, html2text)"
      else
        echo -e "  ${YELLOW}!${NC} Python dependencies incomplete — run: ~/.claude/skills/web-extract/.venv/bin/pip install scrapling html2text browserforge"
      fi
    else
      echo -e "  ${YELLOW}!${NC} Python venv not set up"
    fi
    echo -e "  ${DIM}(Enables 'radioheader learn' and gives Claude Code better web fetching)${NC}"
  else
    echo -e "  ${DIM}–${NC} Not installed (optional — enables 'radioheader learn' command)"
    echo -e "  ${DIM}  Install gives Claude Code the ability to read walled-garden articles${NC}"
    echo -e "  ${DIM}  (WeChat, Medium, Substack) and save 60-70% tokens on web content.${NC}"
  fi

  # --- Optional: RadioMind ---
  echo ""
  echo -e "${BOLD}Optional: RadioMind${NC}"

  if radiomind_available; then
    local rm_version
    rm_version=$(radiomind --version 2>/dev/null || echo "unknown")
    echo -e "  ${GREEN}✓${NC} RadioMind installed ($rm_version)"
    echo -e "  ${DIM}(Enhanced search, three-body refinement, dream pruning — reading your RadioHeader data)${NC}"
  else
    echo -e "  ${DIM}–${NC} Not installed (optional — enhances RadioHeader with deeper memory refinement)"
    echo -e "  ${DIM}  Install: pip install radiomind${NC}"
    echo -e "  ${DIM}  Adds: pyramid search, knowledge graph, three-body debate, dream pruning${NC}"
    echo -e "  ${DIM}  Works alongside RadioHeader — reads the same topics/ and shortwave/ files${NC}"
  fi

  # --- Device Sync (opt-in) ---
  echo ""
  echo -e "${BOLD}Device Sync${NC}"

  if [ "$(config_get device_sync_enabled false)" = "true" ]; then
    if [ -d "$RADIOHEADER_DIR/.git" ]; then
      echo -e "  ${GREEN}✓${NC} Sync repository present"
    else
      echo -e "  ${RED}✗${NC} Enabled but no git repository — run 'radioheader device-sync init'"
      issues=$((issues + 1))
    fi
    if git -C "$RADIOHEADER_DIR" remote get-url origin >/dev/null 2>&1; then
      echo -e "  ${GREEN}✓${NC} Remote configured ($(git -C "$RADIOHEADER_DIR" remote get-url origin 2>/dev/null))"
    else
      echo -e "  ${RED}✗${NC} No remote — run 'radioheader device-sync init --remote <url>'"
      issues=$((issues + 1))
    fi
    if [ "$(git -C "$RADIOHEADER_DIR" config pull.rebase 2>/dev/null)" = "false" ]; then
      echo -e "  ${GREEN}✓${NC} pull.rebase=false (divergent branches merge instead of failing)"
    else
      echo -e "  ${YELLOW}!${NC} pull.rebase not set to false — diverged machines will never converge"
      echo -e "    Fix: git -C $RADIOHEADER_DIR config pull.rebase false"
      issues=$((issues + 1))
    fi
    if [ -x "$CLAUDE_DIR/hooks/radioheader-git-sync.sh" ]; then
      echo -e "  ${GREEN}✓${NC} Sync hook script installed"
    else
      echo -e "  ${RED}✗${NC} Sync hook script missing — run 'radioheader device-sync init' to rewrite it"
      issues=$((issues + 1))
    fi
    if grep -q "radioheader-git-sync.sh" "$CLAUDE_DIR/settings.json" 2>/dev/null; then
      echo -e "  ${GREEN}✓${NC} Auto-sync hooks registered (SessionStart pull / Stop push)"
    else
      echo -e "  ${YELLOW}!${NC} Hooks not registered in settings.json — run 'radioheader device-sync init'"
      issues=$((issues + 1))
    fi
    if [ -f "$RADIOHEADER_DIR/.sync-diverged" ]; then
      echo -e "  ${RED}✗${NC} Sync deferred since $(cat "$RADIOHEADER_DIR/.sync-diverged" 2>/dev/null): unresolved merge conflict"
      echo -e "    Resolve: cd $RADIOHEADER_DIR && git pull --no-rebase  # fix conflicts, commit, push"
      issues=$((issues + 1))
    fi
    if [ "$(config_get device_sync_project_memories false)" = "true" ]; then
      if ! command -v git-crypt >/dev/null 2>&1; then
        echo -e "  ${RED}✗${NC} Encrypted memory sync enabled but git-crypt is missing (brew install git-crypt)"
        issues=$((issues + 1))
      elif [ ! -f "$RADIOHEADER_DIR/.git/git-crypt/keys/default" ]; then
        echo -e "  ${RED}✗${NC} Encrypted memory sync enabled but vault is locked — 'radioheader device-sync key import <keyfile>'"
        issues=$((issues + 1))
      else
        echo -e "  ${GREEN}✓${NC} git-crypt unlocked (project memories sync encrypted)"
      fi
      # Ground truth: cat-file bypasses smudge/clean filters, so a committed
      # memory file must show the GITCRYPT magic — anything else means
      # plaintext secrets leaked into vault history.
      local pm_sample
      pm_sample=$(git -C "$RADIOHEADER_DIR" ls-files -- project-memories/ 2>/dev/null | grep '\.md$' | head -1)
      if [ -n "$pm_sample" ]; then
        if git -C "$RADIOHEADER_DIR" cat-file blob "HEAD:$pm_sample" 2>/dev/null | head -c 16 | LC_ALL=C grep -aq GITCRYPT; then
          echo -e "  ${GREEN}✓${NC} Vault ciphertext verified (GITCRYPT magic in committed blob)"
        else
          echo -e "  ${RED}✗${NC} PLAINTEXT project memory found in vault history ($pm_sample)!"
          echo -e "    Secrets may be exposed in the remote. Rotate affected credentials and"
          echo -e "    rebuild the vault (new repo + 'device-sync encrypt' before first sync)."
          issues=$((issues + 1))
        fi
      fi
    fi
  else
    echo -e "  ${DIM}–${NC} Not enabled (optional — sync topics/shortwave across your machines)"
    echo -e "  ${DIM}  Enable: radioheader device-sync init --remote <private-git-url>${NC}"
  fi

  # --- Summary ---
  echo ""
  if [ "$issues" -eq 0 ]; then
    echo -e "${GREEN}No issues found. RadioHeader is healthy!${NC}"
  else
    echo -e "${YELLOW}Found $issues issue(s). Review the warnings above; some are install/runtime gaps, others are data quality issues.${NC}"
  fi
  echo ""
}

# ============================================================
# align
# ============================================================

cmd_align() {
  local mode="report"

  # Parse flags
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --execute) mode="execute"; shift ;;
      --refs)    mode="refs"; shift ;;
      --help|-h)
        cat <<EOF
${BOLD}radioheader align${NC} — Analyze topics↔shortwave coverage and batch refine

${BOLD}MODES${NC}
  (default)    Show coverage report (analysis only, no changes)
  --execute    Output additionalContext JSON for batch refinement
  --refs       Validate and fix shortwave refs links

EOF
        return 0
        ;;
      *)
        err "Unknown flag: $1"
        return 1
        ;;
    esac
  done

  # Pre-checks
  if [ ! -d "$TOPICS_DIR" ]; then
    err "Topics directory not found: $TOPICS_DIR"
    return 1
  fi

  case "$mode" in
    report)  _align_report ;;
    execute) _align_execute ;;
    refs)    _align_refs ;;
  esac
}

# --- align: report mode ---
_align_report() {
  local topic_files=0
  local total_entries=0
  local sw_files=0
  local total_sw=0
  local report_lines=""

  # Count topic files and entries
  for f in "$TOPICS_DIR"/*.md; do
    [ -f "$f" ] || continue
    topic_files=$((topic_files + 1))
    local bname
    bname=$(basename "$f")
    local count
    count=$(grep -c '^\- \[' "$f" 2>/dev/null || echo "0")
    total_entries=$((total_entries + count))
  done

  # Count shortwave files and collect refs → topic mapping
  # Store as lines "topic_basename:count" in a temp file (bash 3 compat)
  local sw_map_file
  sw_map_file=$(mktemp)
  trap "rm -f '$sw_map_file'" RETURN

  if [ -d "$SHORTWAVE_DIR" ]; then
    for f in "$SHORTWAVE_DIR"/*.md; do
      [ -f "$f" ] || continue
      sw_files=$((sw_files + 1))
      total_sw=$((total_sw + 1))
      # Extract refs field
      local refs_line
      refs_line=$(grep '^refs:' "$f" 2>/dev/null || true)
      if [ -n "$refs_line" ]; then
        local ref_path
        ref_path=$(echo "$refs_line" | sed 's/^refs:[[:space:]]*//' | xargs)
        local ref_base
        ref_base=$(basename "$ref_path")
        echo "$ref_base" >> "$sw_map_file"
      fi
    done
  fi

  # Coverage percentage
  local coverage="0.0"
  if [ "$total_entries" -gt 0 ]; then
    coverage=$(awk "BEGIN { printf \"%.1f\", ($total_sw / $total_entries) * 100 }")
  fi

  echo ""
  echo -e "${BOLD}RadioHeader Alignment Report${NC}"
  echo ""
  echo -e "  Topics:     ${BOLD}$topic_files${NC} files, ${BOLD}$total_entries${NC} entries"
  echo -e "  Shortwave:  ${BOLD}$sw_files${NC} files"
  echo -e "  Coverage:   ${BOLD}${coverage}%${NC} ($total_sw/$total_entries)"
  echo ""

  # Per-topic breakdown
  echo -e "${BOLD}Per-topic breakdown:${NC}"
  for f in "$TOPICS_DIR"/*.md; do
    [ -f "$f" ] || continue
    local bname
    bname=$(basename "$f")
    local count
    count=$(grep -c '^\- \[' "$f" 2>/dev/null || echo "0")
    local sw_count
    sw_count=$(grep -c "^${bname}$" "$sw_map_file" 2>/dev/null || echo "0")
    local uncovered=$((count - sw_count))
    if [ "$uncovered" -lt 0 ]; then uncovered=0; fi
    local pct="0.0"
    if [ "$count" -gt 0 ]; then
      pct=$(awk "BEGIN { printf \"%.1f\", ($sw_count / $count) * 100 }")
    fi
    local indicator=""
    if [ "$uncovered" -gt 0 ]; then
      indicator="${YELLOW} ← $uncovered uncovered${NC}"
    else
      indicator="${GREEN} ✓${NC}"
    fi
    printf "  %-30s %2d/%-3d covered (%5s%%)%b\n" "$bname" "$sw_count" "$count" "$pct" "$indicator"
  done

  # Refs validation
  echo ""
  echo -e "${BOLD}Refs status:${NC}"
  local refs_total=0
  local refs_valid=0
  local refs_broken=0
  local refs_missing=0

  if [ -d "$SHORTWAVE_DIR" ]; then
    for f in "$SHORTWAVE_DIR"/*.md; do
      [ -f "$f" ] || continue
      local refs_line
      refs_line=$(grep '^refs:' "$f" 2>/dev/null || true)
      if [ -z "$refs_line" ]; then
        refs_missing=$((refs_missing + 1))
        continue
      fi
      refs_total=$((refs_total + 1))
      local ref_path
      ref_path=$(echo "$refs_line" | sed 's/^refs:[[:space:]]*//' | xargs)
      # Resolve relative to radioheader dir
      if [ -f "$RADIOHEADER_DIR/$ref_path" ]; then
        refs_valid=$((refs_valid + 1))
      else
        refs_broken=$((refs_broken + 1))
      fi
    done
  fi

  if [ "$refs_broken" -eq 0 ] && [ "$refs_missing" -eq 0 ]; then
    echo -e "  ${GREEN}✓${NC} $refs_valid/$refs_total shortwave refs are valid"
  else
    if [ "$refs_broken" -gt 0 ]; then
      echo -e "  ${RED}✗${NC} $refs_broken broken ref(s)"
    fi
    if [ "$refs_missing" -gt 0 ]; then
      echo -e "  ${YELLOW}!${NC} $refs_missing shortwave file(s) without refs"
    fi
    echo -e "  ${GREEN}✓${NC} $refs_valid valid ref(s)"
  fi

  echo ""
  echo -e "${DIM}Run 'radioheader align --execute' to batch refine uncovered entries.${NC}"
  echo -e "${DIM}Run 'radioheader align --refs' to fix broken refs.${NC}"
  echo ""
}

# --- align: execute mode ---
_align_execute() {
  # Build context string
  local context=""
  context+="📡 短波批量对齐指令\n\n"

  # Coverage summary
  local total_entries=0
  local total_sw=0
  for f in "$TOPICS_DIR"/*.md; do
    [ -f "$f" ] || continue
    local count
    count=$(grep -c '^\- \[' "$f" 2>/dev/null || echo "0")
    total_entries=$((total_entries + count))
  done
  if [ -d "$SHORTWAVE_DIR" ]; then
    total_sw=$(find "$SHORTWAVE_DIR" -name "*.md" -type f 2>/dev/null | wc -l | tr -d ' ')
  fi
  context+="## 覆盖率统计\n"
  context+="- Topics 条目总数: $total_entries\n"
  context+="- Shortwave 条目总数: $total_sw\n"
  context+="\n"

  # Existing shortwave list
  context+="## 已有 Shortwave 条目\n"
  if [ -d "$SHORTWAVE_DIR" ]; then
    for f in "$SHORTWAVE_DIR"/*.md; do
      [ -f "$f" ] || continue
      local bname
      bname=$(basename "$f")
      local title
      title=$(grep '^###' "$f" 2>/dev/null | head -1 | sed 's/^###[[:space:]]*//')
      local refs_line
      refs_line=$(grep '^refs:' "$f" 2>/dev/null | sed 's/^refs:[[:space:]]*//' || true)
      context+="- $bname: $title (refs: $refs_line)\n"
    done
  fi
  context+="\n"

  # Each topic file — full entries
  context+="## Topic 条目原文（逐文件）\n\n"
  for f in "$TOPICS_DIR"/*.md; do
    [ -f "$f" ] || continue
    local bname
    bname=$(basename "$f")
    local count
    count=$(grep -c '^\- \[' "$f" 2>/dev/null || echo "0")
    context+="### $bname ($count 条)\n"
    # Extract all entry lines
    local entries
    entries=$(grep '^\- \[' "$f" 2>/dev/null || true)
    if [ -n "$entries" ]; then
      context+="$entries\n"
    else
      context+="(无条目)\n"
    fi
    context+="\n"
  done

  # Refinement rules
  context+="## 精炼规则（5+1 步）\n"
  context+="1. **去项目化**：移除 [来源:xxx] 标签、项目名、文件路径、专有类名\n"
  context+="2. **保留症状**：保留症状关键词（白屏、崩溃、慢）+ 量化数据（10s+、20-40s）\n"
  context+="3. **抽象化**：提取通用模式，用泛化描述替代项目特定描述\n"
  context+="4. **补充标签**：tags 包含中英文同义词、症状词、技术关键词\n"
  context+="5. **关联 refs**：refs 字段指向源 topic 文件路径（如 topics/ios-swiftui.md）\n"
  context+="+1. **合并相关条目**：语义相近的多条 topic 条目合并为一个 shortwave 条目\n\n"

  # Naming convention
  context+="## 命名规则\n"
  context+="- 格式: sw-{domain}-{slug}.md\n"
  context+="- slug = 从 ### 标题提取 3-5 个英文关键词，小写连字符连接\n"
  context+="- domain 参考: ios, backend, claudecode, network, product, rust, ai\n"
  context+="- 示例: sw-ios-task-inherits-mainactor.md, sw-rust-json-ffi-high-freq.md\n"
  # List existing slugs for reference
  context+="- 已有 slug 列表:\n"
  if [ -d "$SHORTWAVE_DIR" ]; then
    for f in "$SHORTWAVE_DIR"/*.md; do
      [ -f "$f" ] || continue
      context+="  - $(basename "$f" .md)\n"
    done
  fi
  context+="\n"

  # Format spec reference
  context+="## 格式规范\n"
  context+="每个 shortwave 文件包含:\n"
  context+="- YAML frontmatter: id, domain, tags, refs\n"
  context+="- 标题行: ### 一句话概括\n"
  context+="- 正文键值对: symptoms, context, cause, fix, verified (可选), case (可选)\n\n"

  # Instruction
  context+="## 执行指令\n"
  context+="对比上方「已有 Shortwave 条目」和「Topic 条目原文」，判断哪些 topic 条目尚未被覆盖。\n"
  context+="逐个 topic 文件处理，为每组语义相关的未覆盖条目创建一个 shortwave 文件。\n"
  context+="写入路径: $SHORTWAVE_DIR/\n"
  context+="完成后运行 radioheader align 确认覆盖率提升。"

  # Output as hookSpecificOutput JSON
  # Escape the context for JSON
  local escaped_context
  escaped_context=$(printf '%s' "$context" | python3 -c 'import sys,json; print(json.dumps(sys.stdin.read()))')

  cat <<EOF
{
  "hookSpecificOutput": {
    "hookEventName": "PostToolUse",
    "additionalContext": $escaped_context
  }
}
EOF
}

# --- align: refs mode ---
_align_refs() {
  echo ""
  echo -e "${BOLD}RadioHeader Refs Check${NC}"
  echo ""

  if [ ! -d "$SHORTWAVE_DIR" ]; then
    warn "Shortwave directory not found: $SHORTWAVE_DIR"
    return 1
  fi

  local total=0
  local valid=0
  local broken=0
  local missing=0
  local fixed=0

  for f in "$SHORTWAVE_DIR"/*.md; do
    [ -f "$f" ] || continue
    total=$((total + 1))
    local bname
    bname=$(basename "$f")
    local refs_line
    refs_line=$(grep '^refs:' "$f" 2>/dev/null || true)

    if [ -z "$refs_line" ]; then
      # No refs — try to auto-fill from domain
      missing=$((missing + 1))
      local domain_line
      domain_line=$(grep '^domain:' "$f" 2>/dev/null || true)
      if [ -n "$domain_line" ]; then
        local domain_val
        domain_val=$(echo "$domain_line" | sed 's/^domain:[[:space:]]*//' | xargs)
        # Try to match domain keywords against topic filenames
        local matched_topic=""
        local match_count=0
        # Extract first keyword from domain (before comma)
        local first_keyword
        first_keyword=$(echo "$domain_val" | cut -d',' -f1 | xargs | tr '[:upper:]' '[:lower:]')
        for tf in "$TOPICS_DIR"/*.md; do
          [ -f "$tf" ] || continue
          local tf_lower
          tf_lower=$(basename "$tf" | tr '[:upper:]' '[:lower:]')
          if echo "$tf_lower" | grep -qi "$first_keyword" 2>/dev/null; then
            matched_topic=$(basename "$tf")
            match_count=$((match_count + 1))
          fi
        done

        if [ "$match_count" -eq 1 ]; then
          # Unique match — auto-fix
          # Insert refs line after the last frontmatter field (before ---)
          # Find the closing --- line number (second occurrence)
          local close_line
          close_line=$(awk '/^---$/{n++; if(n==2){print NR; exit}}' "$f")
          if [ -n "$close_line" ]; then
            sedi "${close_line}i\\
refs: topics/${matched_topic}" "$f"
            echo -e "  ${GREEN}✓ Fixed${NC} $bname → refs: topics/$matched_topic"
            fixed=$((fixed + 1))
          else
            echo -e "  ${YELLOW}!${NC} $bname: no refs, domain='$domain_val', matched '$matched_topic' but couldn't insert (no closing ---)"
          fi
        elif [ "$match_count" -gt 1 ]; then
          echo -e "  ${YELLOW}!${NC} $bname: no refs, domain='$domain_val' matches multiple topics — manual fix needed"
        else
          echo -e "  ${YELLOW}!${NC} $bname: no refs, domain='$domain_val' matches no topic file"
        fi
      else
        echo -e "  ${YELLOW}!${NC} $bname: no refs and no domain — cannot auto-fix"
      fi
      continue
    fi

    # Has refs — validate
    local ref_path
    ref_path=$(echo "$refs_line" | sed 's/^refs:[[:space:]]*//' | xargs)
    if [ -f "$RADIOHEADER_DIR/$ref_path" ]; then
      valid=$((valid + 1))
      echo -e "  ${GREEN}✓${NC} $bname → $ref_path"
    else
      broken=$((broken + 1))
      # Try to fix: search for similar filename in topics/
      local ref_base
      ref_base=$(basename "$ref_path")
      local found_match=""
      for tf in "$TOPICS_DIR"/*.md; do
        [ -f "$tf" ] || continue
        if [ "$(basename "$tf")" = "$ref_base" ]; then
          found_match="topics/$ref_base"
          break
        fi
      done

      if [ -n "$found_match" ] && [ "$found_match" != "$ref_path" ]; then
        sedi "s|^refs:.*|refs: $found_match|" "$f"
        echo -e "  ${GREEN}✓ Fixed${NC} $bname: $ref_path → $found_match"
        fixed=$((fixed + 1))
      else
        echo -e "  ${RED}✗${NC} $bname → $ref_path (file not found)"
      fi
    fi
  done

  echo ""
  echo -e "${BOLD}Summary:${NC}"
  echo -e "  Total:   $total"
  echo -e "  Valid:   ${GREEN}$valid${NC}"
  if [ "$broken" -gt 0 ]; then
    echo -e "  Broken:  ${RED}$broken${NC}"
  fi
  if [ "$missing" -gt 0 ]; then
    echo -e "  Missing: ${YELLOW}$missing${NC}"
  fi
  if [ "$fixed" -gt 0 ]; then
    echo -e "  Fixed:   ${GREEN}$fixed${NC}"
  fi
  echo ""
}

